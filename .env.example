# ==============================================================================
# wmmw.sh -- environment
#
# v1 needs NO build-time or runtime secrets: content lives in the repo and the
# contact link is the GitHub profile (no contact form, no mail sender, no DB).
# deploy.sh generates .env.prod on the server from these same keys.
# ==============================================================================

# Astro node standalone runtime (read inside the container)
NODE_ENV=production
HOST=0.0.0.0
# Container-internal listen port. docker-compose publishes it on host port 4327
# (nginx vhost routes wmmw.sh -> localhost:4327, TLS via certbot).
PORT=4321

# Reserved: activates once the wmmw.sh mailbox exists.
# See src/lib/site.ts (CONTACT_EMAIL is null until then).
# CONTACT_EMAIL=

# QA annotation overlay — set to "true" to enable the element-click feedback
# tool (Alt+Y). Comments are appended to .prototype-feedback/comments.jsonl.
# Leave unset/blank in production. Build-time inlined, so rebuild after changing.
# ANNOTATION_SYSTEM=true
