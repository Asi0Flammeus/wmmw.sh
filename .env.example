# Intake inbox (spec §8.2). Read through process.env at call time.
INTAKE_DIR=            # default ./.intake locally, /data/intake in the preview container
INTAKE_TOKEN=          # Bearer token for GET/DELETE /api/intake (unset: 401)
INTAKE_SECRET=         # HMAC key of the start token; required by docker-compose.moire.yml
INTAKE_MIN_BRIEF_MS=   # default 8000; QA runs set 300
INTAKE_MIN_GHOSTS_MS=  # default 3000; QA runs set 300
INTAKE_ALLOWED_ORIGINS= # default https://wmmw.sh,https://moire.wmmw.sh
