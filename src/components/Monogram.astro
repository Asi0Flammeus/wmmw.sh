---
/**
 * W·M monogram (spec §5.5, A13), drawn from the MonogramDefs symbols.
 * The line mark is a moiré: below 192 px it aliases into grey mush, so any
 * size under 192 renders the solid mark whatever `variant` asks for.
 * - mirrored: scaleX(-1), reads M·W (the footer palindrome).
 * - tint: ruby on the M (line) or the shared stroke (solid). Ruby means
 *   action, so only identity surfaces (OG, /lab) tint; the footer does not.
 * - label: role="img" with that name; otherwise decorative (aria-hidden).
 */
interface Props {
  variant?: "line" | "solid";
  /** Box size in CSS px (512 grid; the glyph is about 59% of the box height). */
  size?: number;
  mirrored?: boolean;
  tint?: boolean;
  label?: string;
  class?: string;
}

const LINE_MIN = 192;
const { size = 32, mirrored = false, tint = false, label, class: className } = Astro.props;
const asked = Astro.props.variant ?? (size >= LINE_MIN ? "line" : "solid");
const variant = asked === "line" && size < LINE_MIN ? "solid" : asked;
---

<svg
  class:list={["wm", `wm-${variant}`, { "wm-mirrored": mirrored, "wm-tint": tint }, className]}
  viewBox="0 0 512 512"
  width={size}
  height={size}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
  data-moire-layer={variant === "line" ? "q3" : undefined}
  ><use href={variant === "line" ? "#wm-line" : "#wm-solid"}></use></svg
>

<style>
  .wm {
    display: block;
    flex: none;
  }
  .wm-mirrored {
    transform: scaleX(-1);
  }
  .wm-tint {
    --wm-b: var(--accent);
    --wm-s: var(--accent);
  }
  @media (forced-colors: active) {
    .wm {
      color: CanvasText;
      --wm-b: CanvasText;
      --wm-s: CanvasText;
    }
  }
</style>
