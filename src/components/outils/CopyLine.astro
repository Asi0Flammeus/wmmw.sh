---
/**
 * One line of real code in a well, with a copy button (spec §6.5, §7.3).
 * Never a `$` prompt. The button is JS-only (critique E16.4); the code stays
 * selectable without it. Labels come in as props so /outils and /ecrits share it.
 */
import type { Locale } from "@i18n/index";

interface Props {
  code: string;
  locale: Locale;
  copyLabel: string;
  copiedLabel: string;
  /** accessible name of the code line (e.g. « Installer lazyagent ») */
  label?: string;
}

const { code, copyLabel, copiedLabel, label } = Astro.props;
---

<div class="copyline" data-copyline data-copy={copyLabel} data-copied={copiedLabel}>
  <code class="copyline-code" aria-label={label}>{code}</code>
  <button type="button" class="copyline-btn" data-js-only>
    <svg class="copyline-check" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 6.4l2.6 2.6L10 3.4"></path></svg>
    <span class="copyline-label">{copyLabel}</span>
  </button>
</div>

<script>
  let ac: AbortController | undefined;
  document.addEventListener("astro:page-load", () => {
    ac?.abort();
    ac = new AbortController();
    for (const root of document.querySelectorAll<HTMLElement>("[data-copyline]")) {
      const btn = root.querySelector<HTMLButtonElement>(".copyline-btn");
      const code = root.querySelector("code");
      const text = root.querySelector(".copyline-label");
      if (!btn || !code || !text) continue;
      let timer = 0;
      btn.addEventListener(
        "click",
        () => {
          void navigator.clipboard?.writeText(code.textContent ?? "").then(() => {
            text.textContent = root.dataset.copied ?? "";
            root.dataset.state = "copied";
            window.clearTimeout(timer);
            timer = window.setTimeout(() => {
              text.textContent = root.dataset.copy ?? "";
              delete root.dataset.state;
            }, 1600);
          });
        },
        { signal: ac.signal },
      );
    }
  });
  document.addEventListener("astro:before-swap", () => ac?.abort());
</script>

<style>
  .copyline {
    display: flex;
    align-items: stretch;
    max-width: 100%;
    border: 1px solid var(--line);
    border-radius: var(--r-2);
    background: var(--input-bg);
  }
  .copyline-code {
    flex: 1;
    min-width: 0;
    padding: 0.7rem 0.9rem;
    overflow-x: auto;
    white-space: nowrap;
    font-family: var(--mono);
    font-size: var(--fs-code);
    line-height: 1.55;
    color: var(--code-ink);
    background: none;
  }
  .copyline-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    flex: none;
    min-width: var(--tap);
    min-height: var(--tap);
    padding: 0 0.9rem;
    border: 0;
    border-left: 1px solid var(--line);
    border-radius: 0 var(--r-2) var(--r-2) 0;
    background: none;
    font: 500 0.875rem/1 var(--text);
    color: var(--ink-2);
    cursor: pointer;
  }
  .copyline-btn:hover {
    color: var(--ink);
    background: var(--surface);
  }
  .copyline-btn:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  .copyline[data-state="copied"] .copyline-btn {
    color: var(--success);
  }
  .copyline-check {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .copyline:not([data-state="copied"]) .copyline-check {
    display: none;
  }
</style>
