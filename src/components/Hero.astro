---
import { type Locale, t, localePath } from "@i18n/index";

interface Props {
  locale: Locale;
  variant: "full" | "band";
  heading?: string;
}

const { locale, variant, heading = "" } = Astro.props;
const chrome = t(locale);
const { h1a, h1aEm, h1b, sub, cta } = chrome.hero;

/* wrap the accent <em> around the h1aEm substring of h1a (holds for fr/en/es) */
const emAt = h1a.indexOf(h1aEm);
const h1aBefore = emAt >= 0 ? h1a.slice(0, emAt) : h1a;
const h1aAfter = emAt >= 0 ? h1a.slice(emAt + h1aEm.length) : "";
const h1aHasEm = emAt >= 0;

/* break the sub onto a second line before its last sentence (the
   "Je fais circuler..." clause), robust across fr/en/es */
const subCut = sub.lastIndexOf(". ");
const subLead = subCut >= 0 ? sub.slice(0, subCut + 1) : sub;
const subTail = subCut >= 0 ? sub.slice(subCut + 2) : "";
---

<section class:list={["hero", variant]}>
  <div class="hero-veil" aria-hidden="true"></div>
  <div class="hero-copy">
    {
      variant === "full" ? (
        <>
          <h1>
            <span>
              {h1aHasEm ? (
                <>
                  {h1aBefore}
                  <em>{h1aEm}</em>
                  {h1aAfter}
                </>
              ) : (
                h1a
              )}
            </span>
            {h1b && <span>{h1b}</span>}
          </h1>
          <p class="hero-sub">
            {subLead}
            {subTail && (
              <>
                <br />
                {subTail}
              </>
            )}
          </p>
          <p class="hero-cta-row">
            <a class="cta-chip" href={localePath(locale, "/manifeste")}>
              {cta}
              <svg
                class="cta-arrow"
                width="14"
                height="14"
                viewBox="0 0 16 16"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M3 8h10m0 0L9 4m4 4l-4 4"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          </p>
        </>
      ) : (
        <h1 class="band-h">{heading}</h1>
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 5;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    overflow: hidden;
    /* one hero size everywhere; the homepage is the reference */
    min-height: 100dvh;
  }
  .hero-veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  /* Paint = soft top vignette + bottom fondu into --bg for legibility and a
     clean hand-off to the content below. The horizontal mask feathers the veil
     open over the LEFT column (~0-18%) so the unified organism, which is
     left-weighted and exits bottom-left, crosses the hero boundary unwalled.
     The document-level Mycelium canvas shows through from behind. */
  .hero-veil {
    background:
      radial-gradient(120% 95% at 60% 12%, transparent 55%, rgba(18, 16, 13, 0.5) 100%),
      linear-gradient(
        to bottom,
        rgba(18, 16, 13, 0.35) 0%,
        transparent 20%,
        transparent 58%,
        rgba(18, 16, 13, 0.8) 84%,
        var(--bg) 94%
      );
    -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.35) 18%, #000 44%);
    mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.35) 18%, #000 44%);
  }

  /* copy block lives on the RIGHT, away from the left-weighted bloom */
  .hero-copy {
    position: relative;
    z-index: 2;
    max-width: 42rem;
    padding-inline: var(--pad);
    padding-bottom: clamp(3.5rem, 9vh, 6rem);
  }
  /* No copy scrim: the text sits directly over the organism (asi0 review,
     2026-09-04: the translucent card must be fully invisible). */

  .hero h1 {
    font-family: var(--disp);
    font-weight: 500;
    font-size: clamp(2.5rem, 6.5vw, 5.2rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .hero h1 em {
    font-style: normal;
    color: var(--accent);
  }
  .hero .band-h {
    font-family: var(--disp);
    font-weight: 500;
    font-size: clamp(2rem, 4.5vw, 3.4rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    text-wrap: balance;
    color: var(--bone);
    max-width: 24ch;
  }
  .hero-sub {
    margin-top: 1.4rem;
    max-width: 34rem;
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    color: var(--ink-2);
  }
  .hero-cta-row {
    margin-top: 2.1rem;
  }
  .cta-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    font-family: var(--disp);
    font-weight: 500;
    font-size: 1rem;
    letter-spacing: 0.01em;
    text-decoration: none;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid rgba(217, 162, 74, 0.5);
    padding: 0.6em 1.15em;
    border-radius: var(--r-pill);
  }
  /* Membrane: the chip lies directly on the organism, so it frosts what is
     behind it instead of hiding it. Solid --accent-soft stays the fallback. */
  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .cta-chip {
      background: rgba(217, 162, 74, 0.14);
      -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-sat));
      backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-sat));
    }
    .cta-chip:hover,
    .cta-chip:focus-visible {
      background: var(--accent);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }
  .cta-chip:hover,
  .cta-chip:focus-visible {
    background: var(--accent);
    color: var(--bg);
  }
  .cta-chip:active {
    transform: translateY(1px);
  }
  html.anim .cta-chip .cta-arrow {
    transition: transform var(--t-base) var(--ease-swift);
  }
  .cta-chip:hover .cta-arrow,
  .cta-chip:focus-visible .cta-arrow {
    transform: translateX(3px);
  }

  @media (min-width: 768px) {
    .hero.full h1 span {
      display: block;
    }
  }
  @media (max-width: 767px) {
    .hero.full .hero-copy {
      padding-bottom: clamp(4.5rem, 12vh, 7rem);
    }
  }

  html.anim .cta-chip {
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }
</style>
