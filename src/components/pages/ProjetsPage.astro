---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import { type Locale, t } from "@i18n/index";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  locale={locale}
  title={dict.projets.heading}
  description={dict.meta.projets}
  path="/projets"
>
  <section class="sec offset-l" data-block>
    <div class="wrap">
      <div class="sec-inner">
        <p class="sec-intro reveal">{dict.projets.intro}</p>
      </div>
    </div>
  </section>

  {
    projects.map((project, i) => (
      <section
        class:list={["sec", "proj-sec", i % 2 === 0 ? "offset-r" : "offset-l"]}
        data-block
      >
        <div class="wrap">
          <div class="sec-inner">
            <article class="proj reveal">
              <div class="sec-head" data-myc-anchor>
                <h2 class="proj-title">
                  {project.data.url ? (
                    <a href={project.data.url} rel="noopener">
                      {project.data.title}
                    </a>
                  ) : (
                    project.data.title
                  )}
                </h2>
              </div>
              <p class="proj-blurb">{project.data.blurb[locale]}</p>
              <p class="proj-meta">
                <span class="badge">{project.data.status}</span>
                {project.data.url && (
                  <a class="arrow-link" href={project.data.url} rel="noopener">
                    {project.data.url.replace(/^https?:\/\//, "")}
                  </a>
                )}
              </p>
            </article>
          </div>
        </div>
      </section>
    ))
  }
</BaseLayout>

<style>
  .proj-sec {
    padding-block: clamp(2.2rem, 5vw, 4rem);
  }

  .proj-title {
    font-family: var(--disp);
    font-weight: 500;
    font-size: var(--fs-h2);
    letter-spacing: -0.02em;
    line-height: 1.12;
    text-wrap: balance;
  }
  .proj-title a {
    color: inherit;
    text-decoration: none;
  }
  .proj-title a:hover,
  .proj-title a:focus-visible {
    color: var(--accent);
  }
  :global(html.anim) .proj-title a {
    transition: color var(--t-base) ease;
  }

  .proj .sec-head {
    margin-bottom: 1.4rem;
  }

  .proj-blurb {
    color: var(--ink-2);
    max-width: 62ch;
    font-size: var(--fs-lead);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .proj-meta {
    margin-top: 1.4rem;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.4rem;
  }
  .badge {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    padding: 0.18rem 0.75rem;
    border-radius: var(--r-pill);
    background: var(--accent-soft);
    color: var(--accent);
  }
</style>
