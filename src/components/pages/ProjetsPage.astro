---
/**
 * /projets (spec §7.2, copy deck §4): what is running, my role, the proof,
 * what you can get. Renders on demand: the no-JS Ghosts form posts here and
 * the open GhostsNotify answers it (this page never reads the body itself).
 * The tools action is the page's single primary loupe.
 */
import { type Locale, t, localePath, splitLink } from "@i18n/index";
import { ALYSIS_URL, PLANB_URL } from "@lib/site";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHead from "@components/ui/PageHead.astro";
import Arrow from "@components/ui/Arrow.astro";
import Button from "@components/ui/Button.astro";
import ProjectSection from "@components/projets/ProjectSection.astro";
import Part from "@components/projets/Part.astro";
import LinkedText from "@components/projets/LinkedText.astro";
import GhostsNotify from "@components/intake/GhostsNotify.astro";

interface Props {
  locale: Locale;
}

/** Owner default (deck D-31): the agricultural trader proof stays off until he agrees. */
const SHOW_AGRI_PROOF = false;

const { locale } = Astro.props;
const dict = t(locale);
const p = dict.projets;
const { planb, alysis, tools, ghosts } = p.items;
const closing = splitLink(p.closing, p.closingLink);

/* proofs that join the previous one (the story behind the PR) render in its item */
type Proof = (typeof planb.proofs)[number];
const group = (proofs: readonly Proof[]): Proof[][] =>
  proofs.reduce<Proof[][]>((acc, proof) => {
    const last = acc.at(-1);
    if ("join" in proof && proof.join && last) last.push(proof);
    else acc.push([proof]);
    return acc;
  }, []);
---

<BaseLayout locale={locale} title={p.meta.title} description={p.meta.description} path="/projets">
  <div class="wrap projets">
    <PageHead title={p.heading} lead={p.intro} />

    <ProjectSection locale={locale} id="plan-b-academy" title={planb.title} dims={planb.dims}>
      <Part label={p.labels.what}><p>{planb.what}</p></Part>
      <Part label={p.labels.role}><p>{planb.role}</p></Part>
      <Part label={p.labels.proof}>
        <ul>
          {
            group(planb.proofs).map((items) => (
              <li>
                {items.map((proof, i) => (
                  <Fragment>
                    {i > 0 && <br />}
                    <LinkedText locale={locale} {...proof} />
                  </Fragment>
                ))}
              </li>
            ))
          }
        </ul>
      </Part>
      <Part label={p.labels.forYou} emphasis><p><LinkedText locale={locale} {...planb.forYou} /></p></Part>
      <p class="outbound">
        <a href={PLANB_URL} rel="noopener">{planb.link}<Arrow dir="external" /><span class="sr">{dict.a11y.external}</span></a>
      </p>
    </ProjectSection>

    <ProjectSection locale={locale} id="alysis" title={alysis.title} dims={alysis.dims}>
      <Part label={p.labels.what}><p>{alysis.what}</p></Part>
      <Part label={p.labels.role}><p>{alysis.role}</p></Part>
      <Part label={p.labels.proof}>
        <ul>{alysis.proofs.map((proof) => <li><LinkedText locale={locale} {...proof} /></li>)}</ul>
      </Part>
      <Part label={p.labels.forYou} emphasis><p>{alysis.forYou.text}</p></Part>
      <p class="outbound">
        <a href={ALYSIS_URL} rel="noopener">{alysis.link}<Arrow dir="external" /><span class="sr">{dict.a11y.external}</span></a>
      </p>
    </ProjectSection>

    <ProjectSection locale={locale} id="outils-sur-mesure" title={tools.title} dims={tools.dims}>
      <Part label={p.labels.what}><p>{tools.what}</p></Part>
      <Part label={p.labels.role}><p>{tools.role}</p></Part>
      <Part label={p.labels.proof}>
        <ul>
          {tools.proofs.map((proof) => <li><LinkedText locale={locale} {...proof} /></li>)}
          {SHOW_AGRI_PROOF && <li>{tools.agriProof}</li>}
        </ul>
      </Part>
      <Part label={p.labels.forYou} emphasis><p>{tools.forYou.text}</p></Part>
      <p class="action">
        <Button variant="primary" arrow="right" href={`${localePath(locale, "/contact")}?chemin=outil`} locale={locale} data-qa="projets-action">
          {tools.action}
        </Button>
      </p>
    </ProjectSection>

    <ProjectSection locale={locale} id="ghosts" title={ghosts.title}>
      <p class="ghosts-line">{ghosts.line}</p>
      <Part label={p.labels.forYou} emphasis><p>{ghosts.forYou}</p></Part>
      <GhostsNotify locale={locale} open page="/projets" />
    </ProjectSection>

    <p class="closing">
      {closing[0]}<a href={localePath(locale, "/manifeste")}>{closing[1]}</a>{closing[2]}
    </p>
  </div>
</BaseLayout>

<style>
  .outbound {
    margin: 0;
    font-size: var(--fs-body);
  }
  .outbound a {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    min-height: var(--tap);
  }
  .action {
    margin: 0;
  }
  .ghosts-line {
    margin: 0;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--ink-2);
  }
  .closing {
    margin: var(--section-gap) 0 0;
    padding-top: var(--block-gap);
    border-top: 1px solid var(--line);
    max-width: var(--measure);
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
    color: var(--ink);
    text-wrap: balance;
  }
</style>
