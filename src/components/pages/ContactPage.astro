---
/**
 * /contact « Travailler ensemble » (spec §7.7, §8.5): proves before it asks.
 * Renders on demand: GET embeds a fresh start token; a no-JS POST is handled
 * here and answered with the confirmation or the form with its errors.
 * From 1100 px: copy and V1 on the left, the sticky intake card on the right.
 */
import { type Locale, t, splitLink, localePath } from "@i18n/index";
import { MAX_BODY_BYTES, type Brief, type Errors } from "@lib/intake/rules";
import { minMs, mintToken } from "@lib/intake/token";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHead from "@components/ui/PageHead.astro";
import StepsLine from "@components/visual/StepsLine.astro";
import IntakeForm from "@components/intake/IntakeForm.astro";
import Gets from "@components/contact/Gets.astro";
import Elsewhere from "@components/contact/Elsewhere.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const c = dict.contact;
const s = dict.intake;

const CHEMIN: Record<string, string> = { outil: "tool", ouvert: "open", autre: "other", site: "site" };
const cheminParam = Astro.url.searchParams.get("chemin") ?? "";
const chemin = CHEMIN[cheminParam];
const page = `/contact${chemin ? `?chemin=${cheminParam}` : ""}`;

let started = mintToken("brief", locale);
let values: Brief | undefined;
let errors: Errors | undefined;
let invalidToken = false;
let netMessage: string | undefined;
let accepted: { ref: string; fit: string } | undefined;

const request = Astro.request;
if (request.method === "POST") {
  const size = Number(request.headers.get("content-length") ?? 0);
  if (size > MAX_BODY_BYTES) {
    netMessage = s.net.tooLarge;
  } else {
    const form = await request.formData();
    // dynamic on purpose (errata E7): keep the intake modules out of prerendered pages
    const { processIntake, parseForm } = await import("@lib/intake/process");
    const result = await processIntake(parseForm(form), {
      request,
      clientAddress: Astro.clientAddress,
      js: false,
      kind: "brief",
    });
    values = result.brief;
    const posted = form.get("started");
    if (typeof posted === "string" && posted) started = posted;
    if (result.status === 201 && result.accepted) {
      accepted = { ref: result.accepted.ref, fit: result.accepted.fit };
    } else if (result.errors) {
      errors = result.errors;
    } else if (result.fresh) {
      invalidToken = true;
      started = result.fresh;
    } else if (result.status === 429) {
      const minutes = Math.max(1, Math.ceil(Number(result.body.retry_after ?? 600) / 60));
      netMessage = s.net.rate.replace("{minutes}", String(minutes));
    } else {
      netMessage = s.net.server;
    }
  }
}

const legalData = splitLink(s.legal.data, s.legal.dataLink);
---

<BaseLayout locale={locale} title={c.meta.title} description={c.meta.description} path="/contact">
  <div class="wrap contact">
    <div class="contact-head">
      <PageHead title={c.heading} lead={c.lede} />
      <p class="contact-split">{c.split}</p>
    </div>

    <div class="contact-card">
      {netMessage && <p class="contact-net" role="alert">{netMessage}</p>}
      <IntakeForm
        locale={locale}
        started={started}
        minMs={minMs("brief")}
        page={page}
        chemin={chemin}
        values={values}
        errors={errors}
        invalidToken={invalidToken}
        accepted={accepted}
      />
      <p class="contact-legal">
        {s.legal.who}{" "}
        {legalData[0]}<a href={`${localePath(locale, "/mentions-legales")}#donnees`}>{legalData[1]}</a>{legalData[2]}
      </p>
    </div>

    <section class="contact-steps" aria-labelledby="steps-title" data-steps-host>
      <h2 id="steps-title">{c.steps.heading}</h2>
      <StepsLine locale={locale} variant="detailed" />
    </section>
  </div>

  <div class="wrap contact-more">
    <Gets locale={locale} />
    <Elsewhere locale={locale} />
  </div>
</BaseLayout>

<style>
  .contact {
    display: grid;
    grid-template-areas: "head" "card" "steps";
    row-gap: var(--block-gap);
  }
  .contact-head {
    grid-area: head;
  }
  .contact-card {
    grid-area: card;
    align-self: start;
  }
  .contact-steps {
    grid-area: steps;
  }
  .contact-split {
    max-width: var(--measure-lead);
    margin: 1.25rem 0 0;
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
    letter-spacing: var(--ls-lead);
    color: var(--ink);
    text-wrap: balance;
  }
  .contact-steps h2 {
    margin-bottom: 1rem;
    font-size: var(--fs-h3);
  }
  .contact-legal {
    max-width: 60ch;
    margin: 0.9rem 0 0;
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--ink-2);
  }
  .contact-net {
    margin: 0 0 1rem;
    padding: 0.75rem 1rem;
    border-left: 2px solid var(--error);
    color: var(--ink);
  }
  .contact-more {
    display: grid;
    gap: var(--section-gap);
    margin-top: var(--section-gap);
  }
  @media (min-width: 1100px) {
    .contact {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-areas: "head card" "steps card";
      grid-template-rows: auto 1fr;
      column-gap: clamp(2.5rem, 5vw, 4.5rem);
    }
  }
  @media (min-width: 1100px) and (min-height: 760px) {
    .contact-card {
      position: sticky;
      top: calc(var(--header-h) + 1rem);
    }
  }
</style>
