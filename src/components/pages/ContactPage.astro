---
import { Image } from "astro:assets";
import BaseLayout from "@layouts/BaseLayout.astro";
import { type Locale, t } from "@i18n/index";
import { CONTACT_EMAIL, GITHUB_URL, X_URL, PLANB_URL } from "@lib/site";
import portrait from "@assets/william.jpg";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const directHref = CONTACT_EMAIL ? `mailto:${CONTACT_EMAIL}` : X_URL;
const directText = CONTACT_EMAIL
  ? dict.contact.directEmailText
  : dict.contact.directText;
const directCta = CONTACT_EMAIL
  ? dict.contact.directEmailCta
  : dict.contact.directCta;

const links = [
  {
    label: "GitHub",
    handle: "@Asi0Flammeus",
    description: dict.contact.links.github,
    href: GITHUB_URL,
  },
  {
    label: "X",
    handle: "@asi0_flammeus",
    description: dict.contact.links.x,
    href: X_URL,
  },
  {
    label: "Plan ₿ Academy",
    handle: "asi0",
    description: dict.contact.links.planb,
    href: PLANB_URL,
  },
];
---

<BaseLayout
  locale={locale}
  title={dict.contact.heading}
  description={dict.meta.contact}
  path="/contact"
  ogImage={portrait.src}
>
  <section class="sec contact-sec" data-block>
    <div class="wrap contact-layout">
      <figure class="portrait reveal" data-myc-node>
        <Image
          class="portrait-image"
          src={portrait}
          alt={dict.contact.portraitAlt}
          widths={[420, 640, 895]}
          sizes="(max-width: 760px) 82vw, 38vw"
          loading="lazy"
        />
        <figcaption>{dict.contact.portraitCaption}</figcaption>
      </figure>

      <div class="contact-copy">
        <p class="contact-intro reveal">{dict.contact.intro}</p>

        <section class="direct reveal" aria-labelledby="direct-heading">
          <h2 id="direct-heading">{dict.contact.direct}</h2>
          <p>{directText}</p>
          <a class="direct-link" href={directHref} rel="me noopener">
            {directCta}
            <span aria-hidden="true">↗</span>
          </a>
        </section>

        <section class="network reveal" aria-labelledby="network-heading">
          <h2 id="network-heading">{dict.contact.elsewhere}</h2>
          <div class="link-list">
            {
              links.map((link) => (
                <a class="network-link" href={link.href} rel="me noopener">
                  <span class="link-identity">
                    <strong>{link.label}</strong>
                    <span class="handle">{link.handle}</span>
                  </span>
                  <span class="link-description">{link.description}</span>
                  <span class="external" aria-hidden="true">↗</span>
                </a>
              ))
            }
          </div>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-sec {
    padding-top: clamp(4rem, 8vw, 7rem);
  }

  .contact-layout {
    display: grid;
    grid-template-columns: minmax(17rem, 0.76fr) minmax(20rem, 1.24fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: start;
  }

  .portrait {
    position: sticky;
    top: 2rem;
    margin: 0;
  }

  .portrait-image {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 25%;
    border-radius: var(--r-tile);
    filter: saturate(0.78) contrast(1.04);
  }

  .portrait figcaption {
    margin-top: 0.8rem;
    font-family: var(--mono);
    font-size: var(--fs-meta);
    color: var(--ink-3);
  }

  .contact-copy {
    padding-top: clamp(0rem, 4vw, 3.5rem);
  }

  .contact-intro {
    max-width: 42ch;
    font-family: var(--disp);
    font-size: clamp(1.65rem, 3.3vw, 2.55rem);
    font-weight: 500;
    line-height: 1.24;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .direct {
    margin-top: clamp(3rem, 7vw, 5.5rem);
    max-width: 58ch;
  }

  .direct h2,
  .network h2 {
    font-family: var(--disp);
    font-size: var(--fs-h3);
    font-weight: 500;
    line-height: 1.25;
    text-wrap: balance;
  }

  .direct p {
    margin-top: 0.8rem;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .direct-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.35rem;
    padding: 0.62em 1.15em;
    border: 1px solid rgba(217, 162, 74, 0.5);
    border-radius: var(--r-pill);
    background: var(--accent-soft);
    color: var(--accent);
    font-family: var(--disp);
    font-weight: 500;
    text-decoration: none;
  }

  .direct-link:hover,
  .direct-link:focus-visible {
    background: var(--accent);
    color: var(--bg);
  }

  .network {
    margin-top: clamp(3.5rem, 8vw, 6rem);
  }

  .link-list {
    margin-top: 1.2rem;
    border-bottom: 1px solid var(--hair-2);
  }

  .network-link {
    display: grid;
    grid-template-columns: minmax(9.5rem, 0.8fr) minmax(12rem, 1.2fr) auto;
    gap: 1rem 1.5rem;
    align-items: center;
    padding-block: 1.3rem;
    border-top: 1px solid var(--hair-2);
    color: inherit;
    text-decoration: none;
  }

  .link-identity {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .link-identity strong {
    font-family: var(--disp);
    font-size: 1.05rem;
    font-weight: 500;
  }

  .handle {
    color: var(--ink-3);
    font-family: var(--mono);
    font-size: 0.74rem;
  }

  .link-description {
    color: var(--ink-2);
    font-size: var(--fs-small);
    text-wrap: pretty;
  }

  .external {
    color: var(--accent);
    font-size: 1.15rem;
  }

  :global(html.anim) .direct-link,
  :global(html.anim) .network-link {
    transition:
      color var(--t-base) var(--ease-out),
      background-color var(--t-base) var(--ease-out),
      border-color var(--t-base) var(--ease-out);
  }

  :global(html.anim) .direct-link span,
  :global(html.anim) .network-link .external {
    transition: transform var(--t-base) var(--ease-swift);
  }

  .direct-link:hover span,
  .direct-link:focus-visible span,
  .network-link:hover .external,
  .network-link:focus-visible .external {
    transform: translate(2px, -2px);
  }

  .network-link:hover,
  .network-link:focus-visible {
    color: var(--accent);
  }

  @media (max-width: 760px) {
    .contact-layout {
      grid-template-columns: 1fr;
      gap: 2.8rem;
    }

    .portrait {
      position: static;
      width: min(82vw, 25rem);
    }

    .contact-copy {
      padding-top: 0;
    }

    .network-link {
      grid-template-columns: 1fr auto;
    }

    .link-description {
      grid-column: 1;
    }

    .external {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }
</style>
