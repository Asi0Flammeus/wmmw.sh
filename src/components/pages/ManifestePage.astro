---
/**
 * /manifeste (spec §7.6): the reading layout. h1 from the frontmatter title,
 * the prose body, the « Tous les écrits » end link. No CTA, no portrait, no moiré.
 */
import { getCollection, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHead from "@components/ui/PageHead.astro";
import Arrow from "@components/ui/Arrow.astro";
import { type Locale, t, localePath } from "@i18n/index";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const entry = (await getCollection("manifeste")).find((e) => e.data.lang === locale);
if (!entry) throw new Error(`Missing manifeste entry for locale "${locale}".`);
const { Content } = await render(entry);
---

<BaseLayout
  locale={locale}
  title={dict.manifeste.meta.title}
  description={dict.manifeste.meta.description}
  path="/manifeste"
>
  <article class="wrap">
    <div class="measure reading">
      <PageHead title={entry.data.title} />
      <div class="prose manifesto">
        <Content />
      </div>
      <p class="reading-end">
        <a href={localePath(locale, "/ecrits")}>{dict.common.allWritings}<Arrow dir="right" /></a>
      </p>
    </div>
  </article>
</BaseLayout>

<style>
  .reading {
    margin-inline: auto;
  }
  .manifesto {
    margin-top: var(--block-gap);
  }
  .reading-end {
    margin: var(--section-gap) 0 0;
  }
  .reading-end a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: var(--tap);
  }
</style>
