---
import { getCollection, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import TerminalPanel from "@components/TerminalPanel.astro";
import { type Locale, t, localePath } from "@i18n/index";
import { TERM_USER } from "@lib/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);

const entries = await getCollection("manifeste");
const entry = entries.find((e) => e.data.lang === locale);
if (!entry) {
  throw new Error(`Missing manifeste entry for locale "${locale}".`);
}

const { Content } = await render(entry);
const ecritsHref = localePath(locale, "/ecrits");
---

<BaseLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
  path="/manifeste"
>
  <section class="sec offset-l" data-block>
    <div class="wrap">
      <div class="sec-inner">
        <p class="crumb">
          <span class="ps"><b>{TERM_USER}</b>:~$</span>
          {" "}{dict.manifeste.readMore}
        </p>
        <h1 class="disp-h reveal">{entry.data.title}</h1>
        <TerminalPanel path="~/manifeste" class="reveal">
          <div class="out manifesto" data-step="fade">
            <Content />
          </div>
          <p class="cmdline endline" data-step="fade">
            <span class="ps"><b>{TERM_USER}</b>:~$</span>
            {" "}<a class="cd" href={ecritsHref}>cd ecrits/</a>
          </p>
        </TerminalPanel>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* quiet mono breadcrumb: static prompt, no typing */
  .crumb {
    font-family: var(--mono);
    font-size: 0.82rem;
    letter-spacing: 0.01em;
    color: var(--ink-3);
    margin-bottom: 1.4rem;
    overflow-wrap: anywhere;
  }
  .crumb .ps {
    white-space: nowrap;
  }
  .crumb .ps b {
    color: var(--accent);
    font-weight: 500;
  }

  /* markdown-flavoured long-form cat: readable body, mono heading tokens */
  .manifesto {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    max-width: 65ch;
  }
  .manifesto :global(h2) {
    font-family: var(--mono);
    font-size: 0.95rem;
    letter-spacing: 0.01em;
    font-weight: 600;
    color: var(--bone);
    margin-top: 0.8rem;
  }
  .manifesto :global(h2)::before {
    content: "## ";
    color: var(--accent);
  }
  .manifesto :global(h3) {
    font-family: var(--mono);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--bone);
    margin-top: 0.6rem;
  }
  .manifesto :global(h3)::before {
    content: "### ";
    color: var(--accent);
  }
  .manifesto :global(p) {
    font-family: var(--body);
    font-size: 1.02rem;
    line-height: 1.72;
    color: var(--ink-2);
  }
  .manifesto :global(strong) {
    color: var(--accent);
    font-weight: 600;
  }
  .manifesto :global(blockquote) {
    margin: 0;
    border: 0;
    padding: 0;
  }
  .manifesto :global(blockquote p) {
    color: var(--accent);
    font-weight: 500;
  }
  .manifesto :global(blockquote p)::before {
    content: "> ";
    font-family: var(--mono);
    color: var(--ink-3);
  }
  .manifesto :global(ul),
  .manifesto :global(ol) {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 0;
    margin: 0;
  }
  .manifesto :global(li) {
    font-family: var(--body);
    color: var(--ink-2);
  }
  .manifesto :global(li)::before {
    content: "- ";
    font-family: var(--mono);
    color: var(--ink-3);
  }
  .manifesto :global(a) {
    color: var(--accent);
    text-decoration: none;
    text-underline-offset: 3px;
  }
  .manifesto :global(a:hover) {
    text-decoration: underline;
  }

  .endline {
    margin-top: 1.8rem;
  }
  .endline .cd {
    color: var(--accent);
    text-decoration: none;
  }
  .endline .cd:hover {
    text-decoration: underline;
  }
</style>
