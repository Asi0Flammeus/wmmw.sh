---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@layouts/BaseLayout.astro";
import { type Locale, t, localePath } from "@i18n/index";
import portrait from "@assets/william.jpg";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);

const entries = await getCollection("manifeste");
const entry = entries.find((e) => e.data.lang === locale);
if (!entry) {
  throw new Error(`Missing manifeste entry for locale "${locale}".`);
}

const { Content } = await render(entry);
const ecritsHref = localePath(locale, "/ecrits");
---

<BaseLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
  path="/manifeste"
>
  <section class="sec" data-block>
    <div class="man-wrap">
      <div class="manifesto reveal">
        <Content />
      </div>
      <figure class="signature reveal" data-myc-node>
        <Image
          class="sig-portrait"
          src={portrait}
          alt={dict.manifeste.signatureAlt}
          widths={[320, 480, 640]}
          sizes="(max-width: 640px) 62vw, 320px"
          loading="lazy"
        />
        <figcaption class="sig-caption">
          <span class="sig-name">{dict.manifeste.signature}</span>
          <span class="sig-line">{dict.manifeste.signatureLine}</span>
        </figcaption>
      </figure>
      <p class="man-end reveal">
        <a class="arrow-link" href={ecritsHref}>{dict.ecrits.all}</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- signature: the face at the foot of the letter ----------
     No avatar circle, no about-page card. The portrait is masked so it
     dissolves into the humus instead of sitting in a hard rectangle, the way
     the organism does. It carries data-myc-node, so the network reaches for
     it: the last thing the mycelium touches on this page is him. */
  .signature {
    margin: 4.5rem 0 0;
    display: grid;
    grid-template-columns: minmax(0, 15rem) 1fr;
    gap: 1.6rem 2rem;
    align-items: end;
  }
  .sig-portrait {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 2px;
    /* dissolve into the background on every edge, strongest at the bottom:
       a radial core intersected with a bottom fade, so he emerges from the
       humus rather than sitting in a cut-out rectangle */
    -webkit-mask-image:
      radial-gradient(96% 74% at 50% 40%, #000 22%, rgba(0, 0, 0, 0.55) 55%, transparent 82%),
      linear-gradient(to bottom, #000 46%, transparent 96%);
    mask-image:
      radial-gradient(96% 74% at 50% 40%, #000 22%, rgba(0, 0, 0, 0.55) 55%, transparent 82%),
      linear-gradient(to bottom, #000 46%, transparent 96%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
    filter: saturate(0.82) contrast(1.02);
  }
  .sig-caption {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-bottom: 2.6rem;
  }
  .sig-name {
    font-family: var(--disp);
    font-size: clamp(1.6rem, 3.4vw, 2.2rem);
    line-height: 1;
    color: var(--bone);
  }
  .sig-line {
    font-family: var(--mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.02em;
    color: var(--ink-3);
  }

  @media (max-width: 640px) {
    .signature {
      grid-template-columns: minmax(0, 62vw);
      gap: 1.1rem;
      align-items: start;
    }
    .sig-caption {
      padding-bottom: 0;
    }
  }

  .man-wrap {
    max-width: 65ch;
    margin-inline: auto;
    padding-inline: var(--pad);
  }

  /* long-form editorial prose */
  .manifesto {
    display: flex;
    flex-direction: column;
    gap: 1.3rem;
  }
  .manifesto :global(h2) {
    font-family: var(--disp);
    font-weight: 500;
    font-size: clamp(1.5rem, 3vw, 1.9rem);
    letter-spacing: -0.02em;
    line-height: 1.2;
    text-wrap: balance;
    color: var(--bone);
    margin-top: 1.6rem;
  }
  .manifesto :global(h3) {
    font-family: var(--disp);
    font-weight: 500;
    font-size: 1.3rem;
    line-height: 1.25;
    color: var(--bone);
    margin-top: 1rem;
  }
  .manifesto :global(p) {
    font-size: 1.0625rem;
    line-height: 1.72;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .manifesto :global(strong) {
    color: var(--bone);
    font-weight: 600;
  }
  .manifesto :global(blockquote) {
    margin: 0.4rem 0;
    border: 0;
    padding: 0;
  }
  .manifesto :global(blockquote p) {
    font-family: var(--disp);
    font-weight: 500;
    font-size: var(--fs-h3);
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--accent);
    text-wrap: balance;
  }
  .manifesto :global(ul),
  .manifesto :global(ol) {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding-left: 1.3rem;
    margin: 0;
  }
  .manifesto :global(li) {
    color: var(--ink-2);
  }
  .manifesto :global(li::marker) {
    color: var(--accent);
  }
  .manifesto :global(a) {
    color: var(--accent);
    text-decoration: none;
    text-underline-offset: 3px;
  }
  .manifesto :global(a:hover),
  .manifesto :global(a:focus-visible) {
    text-decoration: underline;
  }

  .man-end {
    margin-top: 3rem;
  }
</style>
