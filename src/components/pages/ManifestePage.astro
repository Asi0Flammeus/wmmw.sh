---
import { getCollection, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import TerminalPanel from "@components/TerminalPanel.astro";
import { type Locale, t, localePath } from "@i18n/index";
import { TERM_USER } from "@lib/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);

const entries = await getCollection("manifeste");
const entry = entries.find((e) => e.data.lang === locale);
if (!entry) {
  throw new Error(`Missing manifeste entry for locale "${locale}".`);
}

const { Content } = await render(entry);
const ecritsHref = localePath(locale, "/ecrits");
---

<BaseLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
  path="/manifeste"
>
  <section class="sec offset-l" data-block>
    <div class="wrap">
      <div class="sec-inner">
        <p class="crumb mask" style="--d:60ms">
          <span class="ps"><b>{TERM_USER}</b>:~$</span>
          {" "}{dict.manifeste.readMore}
        </p>

        {/* Pull-quote: the manifesto's own thesis, printed once on paper as the
            page epigraph. The same two sentences run again inside <Content /> as
            a blockquote, so this copy is aria-hidden: a screen reader should not
            hear the thesis twice. */}
        <aside
          class="pull paper par fade"
          style="--pd:8; --d:320ms"
          aria-hidden="true"
        >
          <p class="pull-q">
            <span class="pull-a">{dict.manifeste.heading}</span>{" "}
            <span class="pull-b">{dict.manifeste.headingGold}</span>
          </p>
        </aside>

        <TerminalPanel path="~/manifeste" d={420}>
          <div class="out manifesto" data-step="fade">
            <Content />
          </div>
          <p class="cmdline endline" data-step="fade">
            <span class="ps"><b>{TERM_USER}</b>:~$</span>
            {" "}<a class="cd" href={ecritsHref}>cd ecrits/</a>
          </p>
        </TerminalPanel>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* quiet mono breadcrumb: static prompt, no typing */
  .crumb {
    font-family: var(--mono);
    font-size: 0.82rem;
    letter-spacing: 0.01em;
    color: var(--ink-3);
    margin-bottom: 1.4rem;
    overflow-wrap: anywhere;
  }
  .crumb .ps {
    white-space: nowrap;
  }
  .crumb .ps b {
    color: var(--accent);
    font-weight: 500;
  }

  /* ---------- paper epigraph: the one light surface on this page ----------
     A shallow rung only. Anything deeper would sway the thesis while the eye
     is already reading, and this page is a reading page first. */
  .pull {
    margin-bottom: clamp(2rem, 4vw, 3.2rem);
    /* .fade owns this element's transition property, so .paper's own box-shadow
       easing is spliced back in ahead of the entrance. */
    --mask-also: box-shadow 0.8s var(--ease);
  }
  .pull-q {
    margin: 0;
    font-family: var(--disp);
    font-weight: 400;
    font-size: clamp(1.5rem, 3.2vw, 2.3rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  /* No gold on paper: the accent measures 1.9:1 here. The thesis takes full
     ink instead and the setup line steps back to the label tone. */
  .pull-a {
    color: var(--paper-label);
  }
  .pull-b {
    color: var(--paper-ink);
  }

  /* --d inherits: a wrapper's entrance delay stops at its own children, so the
     long-form body never absorbs the epigraph's stagger. */
  .crumb > :global(*),
  .pull > :global(*),
  .manifesto > :global(*) {
    --d: 0ms;
  }

  /* markdown-flavoured long-form cat: readable body, mono heading tokens */
  .manifesto {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    max-width: 65ch;
  }
  .manifesto :global(h2) {
    font-family: var(--mono);
    font-size: 0.95rem;
    letter-spacing: 0.01em;
    font-weight: 600;
    color: var(--bone);
    margin-top: 0.8rem;
  }
  .manifesto :global(h2)::before {
    content: "## ";
    color: var(--accent);
  }
  .manifesto :global(h3) {
    font-family: var(--mono);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--bone);
    margin-top: 0.6rem;
  }
  .manifesto :global(h3)::before {
    content: "### ";
    color: var(--accent);
  }
  .manifesto :global(p) {
    font-family: var(--body);
    font-size: 1.02rem;
    line-height: 1.72;
    color: var(--ink-2);
  }
  .manifesto :global(strong) {
    color: var(--accent);
    font-weight: 600;
  }
  .manifesto :global(blockquote) {
    margin: 0;
    border: 0;
    padding: 0;
  }
  .manifesto :global(blockquote p) {
    color: var(--accent);
    font-weight: 500;
  }
  .manifesto :global(blockquote p)::before {
    content: "> ";
    font-family: var(--mono);
    color: var(--ink-3);
  }
  .manifesto :global(ul),
  .manifesto :global(ol) {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 0;
    margin: 0;
  }
  .manifesto :global(li) {
    font-family: var(--body);
    color: var(--ink-2);
  }
  .manifesto :global(li)::before {
    content: "- ";
    font-family: var(--mono);
    color: var(--ink-3);
  }
  .manifesto :global(a) {
    color: var(--accent);
    text-decoration: none;
    text-underline-offset: 3px;
  }
  .manifesto :global(a:hover) {
    text-decoration: underline;
  }

  .endline {
    margin-top: 1.8rem;
  }
  .endline .cd {
    color: var(--accent);
    text-decoration: none;
  }
  .endline .cd:hover {
    text-decoration: underline;
  }
</style>
