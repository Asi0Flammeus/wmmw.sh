---
/**
 * /outils (spec §7.3, copy deck §5): free tools, plain blurbs, a real install
 * line where one exists, the repo link. Closing: a secondary door to the
 * tool intake. No terminal panels, no typed lines, no counters.
 */
import { getCollection } from "astro:content";
import { type Locale, t, localePath } from "@i18n/index";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHead from "@components/ui/PageHead.astro";
import Arrow from "@components/ui/Arrow.astro";
import Button from "@components/ui/Button.astro";
import CopyLine from "@components/outils/CopyLine.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const o = dict.outils;
const tools = (await getCollection("tools")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout locale={locale} title={o.meta.title} description={o.meta.description} path="/outils">
  <div class="wrap">
    <PageHead title={o.heading} lead={o.intro} />
    <ul class="tools">
      {
        tools.map(({ data }) => (
          <li class="tool" id={data.name}>
            <div class="tool-head">
              <h2 class="tool-name">{data.name}</h2>
              <span class="tool-status">{o.status[data.status]}</span>
            </div>
            <p class="tool-blurb">{data.blurb[locale]}</p>
            {data.install && (
              <div class="tool-install">
                <p class="tool-micro">{o.install}</p>
                <CopyLine
                  code={data.install}
                  locale={locale}
                  copyLabel={o.copy}
                  copiedLabel={o.copied}
                  label={`${o.install} ${data.name}`}
                />
              </div>
            )}
            {data.repo ? (
              <a class="tool-repo" href={data.repo} rel="noopener">
                {o.repo}
                <Arrow dir="external" />
                <span class="sr">{dict.a11y.external}</span>
              </a>
            ) : (
              <p class="tool-private">{o.private}</p>
            )}
          </li>
        ))
      }
    </ul>
    <div class="tools-cta">
      <p>{o.cta.line}</p>
      <Button variant="secondary" arrow="right" href={`${localePath(locale, "/contact")}?chemin=outil`} locale={locale}>
        {o.cta.link}
      </Button>
    </div>
  </div>
</BaseLayout>

<style>
  .tools {
    list-style: none;
    margin: var(--block-gap) 0 0;
    padding: 0;
    max-width: var(--measure);
  }
  .tool {
    display: grid;
    gap: 0.75rem;
    padding-block: 1.6rem;
    border-top: 1px solid var(--line);
  }
  .tool:last-child {
    border-bottom: 1px solid var(--line);
  }
  .tool-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1rem;
  }
  .tool-name {
    margin: 0;
    font-size: var(--fs-h3);
  }
  .tool-status,
  .tool-micro {
    font-family: var(--mono);
    font-size: var(--fs-meta);
    line-height: var(--lh-mono);
    letter-spacing: var(--ls-mono);
    color: var(--ink-3);
  }
  .tool-micro {
    margin: 0 0 0.35rem;
  }
  .tool-blurb {
    margin: 0;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--ink-2);
  }
  .tool-repo {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    justify-self: start;
    min-height: var(--tap);
  }
  .tool-private {
    margin: 0;
    color: var(--ink-3);
  }
  .tools-cta {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
    margin-top: var(--section-gap);
  }
  .tools-cta p {
    margin: 0;
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
    text-wrap: balance;
  }
</style>
