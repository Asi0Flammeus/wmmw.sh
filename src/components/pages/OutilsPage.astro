---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import TerminalPanel from "@components/TerminalPanel.astro";
import TermCmd from "@components/TermCmd.astro";
import { type Locale, t } from "@i18n/index";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);

const tools = (await getCollection("tools")).sort(
  (a, b) => a.data.order - b.data.order,
);

/** Public destination for the tree name: repo when open, product url otherwise. */
const dest = (data: (typeof tools)[number]["data"]) => data.repo ?? data.url;
---

<BaseLayout
  locale={locale}
  title={dict.outils.heading}
  description={dict.meta.outils}
  path="/outils"
>
  <section class="sec offset-l" data-block>
    <div class="wrap">
      <div class="sec-inner">
        <h1 class="disp-h reveal">{dict.outils.heading}</h1>
      </div>
    </div>
  </section>

  <section class="sec offset-r" data-block>
    <div class="wrap">
      <div class="sec-inner">
        <TerminalPanel path="~/outils" class="reveal">
          <TermCmd command={dict.outils.cmd} />
          <div class="out" data-step="fade">
            <p class="c intro">{dict.outils.intro}</p>
            <div class="tree">
              <p class="troot">outils/</p>
              {
                tools.map((tool, i) => {
                  const glyph = i === tools.length - 1 ? "└── " : "├── ";
                  const href = dest(tool.data);
                  return (
                    <div class="trow">
                      <span class="tname">
                        <span class="tg">{glyph}</span>
                        {href ? (
                          <a href={href} rel="noopener">
                            {tool.data.name}
                          </a>
                        ) : (
                          tool.data.name
                        )}
                      </span>
                      <span class="tdesc">{tool.data.blurb[locale]}</span>
                    </div>
                  );
                })
              }
            </div>
            <p class="tsum">{dict.outils.treeSummary(tools.length)}</p>
          </div>
        </TerminalPanel>
      </div>
    </div>
  </section>

  <section class="sec offset-l" data-block>
    <div class="wrap">
      <div class="sec-inner">
        <TerminalPanel path="~/outils" class="reveal">
          {
            tools.map((tool) => (
              <>
                <TermCmd command={`cat ${tool.data.name}/README.md`} />
                <div class="out" data-step="fade">
                  <p class="tdhead">
                    <strong>{tool.data.name}</strong>
                    <span class="badge">{tool.data.status}</span>
                  </p>
                  <p class="tddesc">{tool.data.blurb[locale]}</p>
                  {tool.data.repo ? (
                    <p class="tdlink">
                      <a href={tool.data.repo} rel="noopener">
                        {`-> ${tool.data.repo}`}
                      </a>
                    </p>
                  ) : (
                    tool.data.url && (
                      <p class="tdlink">
                        <span class="c">{dict.outils.repoPrivate}</span>{" "}
                        <a href={tool.data.url} rel="noopener">
                          {`-> ${tool.data.url}`}
                        </a>
                      </p>
                    )
                  )}
                  {tool.data.install && (
                    <p class="install">
                      <span class="idollar" aria-hidden="true">$</span>
                      {" "}
                      {tool.data.install}
                    </p>
                  )}
                </div>
              </>
            ))
          }
        </TerminalPanel>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* tree overview */
  .tree {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .troot {
    color: var(--bone);
    font-weight: 700;
  }
  .trow {
    display: grid;
    grid-template-columns: 26ch 1fr;
    column-gap: 2ch;
    align-items: baseline;
  }
  .tg {
    color: var(--ink-3);
  }
  .tname {
    color: var(--accent);
    font-weight: 600;
    white-space: pre;
  }
  .tname a {
    color: var(--accent);
    text-decoration: none;
  }
  .tname a:hover {
    color: var(--accent-2);
    text-decoration: underline;
  }
  .tdesc {
    color: var(--ink-2);
  }
  .tsum {
    margin-top: 1.3rem;
    color: var(--ink-3);
  }

  /* per-tool detail groups */
  .tdhead {
    display: flex;
    align-items: baseline;
    gap: 1ch;
    flex-wrap: wrap;
  }
  .tdhead strong {
    color: var(--accent);
    font-weight: 700;
  }
  .badge {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    padding: 0.18rem 0.75rem;
    border-radius: var(--r-pill);
    background: var(--accent-soft);
    color: var(--accent);
  }
  .tddesc {
    color: var(--ink-2);
    max-width: 62ch;
    margin-top: 0.35rem;
  }
  .tdlink {
    margin-top: 0.6rem;
    overflow-wrap: anywhere;
  }
  .tdlink a {
    color: var(--accent);
    text-decoration: none;
  }
  .tdlink a:hover {
    color: var(--accent-2);
    text-decoration: underline;
  }
  .install {
    margin-top: 0.6rem;
    color: var(--bone);
    font-weight: 500;
    overflow-wrap: anywhere;
  }
  .idollar {
    color: var(--ink-3);
  }

  @media (max-width: 767px) {
    .trow {
      grid-template-columns: 1fr;
      row-gap: 0.1rem;
    }
    .trow .tdesc {
      padding-left: 4ch;
    }
  }
</style>
