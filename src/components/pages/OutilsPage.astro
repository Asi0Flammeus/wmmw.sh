---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import { type Locale, t } from "@i18n/index";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);

const tools = (await getCollection("tools")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  locale={locale}
  title={dict.outils.heading}
  description={dict.meta.outils}
  path="/outils"
>
  <section class="sec offset-l" data-block>
    <div class="wrap">
      <div class="sec-inner">
        <p class="sec-intro reveal">{dict.outils.intro}</p>
        <div class="rows reveal">
          {
            tools.map((tool) => {
              const mainHref = tool.data.repo ?? tool.data.url;
              return (
                <article class="row-item tool">
                  <div class="tool-head">
                    <h2 class="tool-name">
                      {mainHref ? (
                        <a href={mainHref} rel="noopener">
                          {tool.data.name}
                        </a>
                      ) : (
                        tool.data.name
                      )}
                    </h2>
                    <span class="badge">{tool.data.status}</span>
                  </div>
                  <p class="tool-blurb">{tool.data.blurb[locale]}</p>
                  {!tool.data.repo && tool.data.url && (
                    <p class="tool-note">{dict.outils.repoPrivate}</p>
                  )}
                  {tool.data.install && (
                    <p class="tool-install">
                      <code>{tool.data.install}</code>
                    </p>
                  )}
                </article>
              );
            })
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .rows {
    margin-top: 2.6rem;
  }
  .tool {
    padding-block: 1.9rem;
  }
  .tool-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .tool-name {
    font-family: var(--disp);
    font-weight: 500;
    font-size: var(--fs-h3);
    letter-spacing: -0.01em;
    color: var(--bone);
  }
  .tool-name a {
    color: inherit;
    text-decoration: none;
  }
  .tool-name a:hover,
  .tool-name a:focus-visible {
    color: var(--accent);
  }
  :global(html.anim) .tool-name a {
    transition: color var(--t-base) ease;
  }
  .badge {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    padding: 0.18rem 0.75rem;
    border-radius: var(--r-pill);
    background: var(--accent-soft);
    color: var(--accent);
  }
  .tool-blurb {
    margin-top: 0.6rem;
    color: var(--ink-2);
    max-width: 58ch;
    text-wrap: pretty;
  }
  .tool-note {
    margin-top: 0.5rem;
    color: var(--ink-3);
    font-size: var(--fs-small);
  }
  .tool-install {
    margin-top: 0.9rem;
  }
  .tool-install code {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--bone);
    background: var(--surf);
    border: 1px solid var(--hair-2);
    border-radius: 6px;
    padding: 0.4em 0.8em;
    overflow-wrap: anywhere;
  }
</style>
