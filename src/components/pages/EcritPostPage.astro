---
/**
 * A writing (spec §7.5): back link, title with byline, dates, tags and
 * translations, cover, the prose, the end back link. No moiré, no glass,
 * no sidebars, no share buttons.
 */
import { Image } from "astro:assets";
import { render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHead from "@components/ui/PageHead.astro";
import Arrow from "@components/ui/Arrow.astro";
import { type Locale, t, localePath, formatDate, isoDate } from "@i18n/index";
import { baseSlug, translationsOf, type Writing } from "@lib/writings";
import "@styles/crqpt-compat.css";

interface Props {
  locale: Locale;
  entry: Writing;
}

const { locale, entry } = Astro.props;
const dict = t(locale);
const e = dict.ecrits;
const { data } = entry;
const slug = baseSlug(entry);
const translations = await translationsOf(entry);
const { Content } = await render(entry);
const byline = data.author === "asi0" ? e.byLegacy : e.by;
const back = localePath(locale, "/ecrits");
---

<BaseLayout
  locale={locale}
  title={data.title}
  description={data.description}
  path={`/ecrits/${slug}`}
  ogType="article"
  ogImage={data.image ? data.image.src : undefined}
  ogImageAlt={data.imageAlt}
  alternatesFor={[locale, ...translations.map((tr) => tr.data.lang)]}
  langFallbackPath="/ecrits"
>
  <article class="wrap post">
    <div class="measure post-col">
      <a class="post-back" href={back}><Arrow dir="left" />{e.back}</a>
      <PageHead title={data.title} size="post">
        <div slot="meta" class="post-meta">
          <p class="post-by">{byline}</p>
          <p class="post-dates">
            {e.published} <time datetime={isoDate(data.publishedAt)}>{formatDate(data.publishedAt, locale)}</time>
            {
              data.updatedAt && (
                <Fragment>
                  <span aria-hidden="true"> · </span>
                  {e.updated} <time datetime={isoDate(data.updatedAt)}>{formatDate(data.updatedAt, locale)}</time>
                </Fragment>
              )
            }
          </p>
          {
            data.tags.length > 0 && (
              <ul class="post-tags">
                {data.tags.map((tag) => (
                  <li>#{tag}</li>
                ))}
              </ul>
            )
          }
          {
            translations.length > 0 && (
              <p class="post-translations">
                {e.translations}{" "}
                {translations.map((tr, i) => (
                  <Fragment>
                    {i > 0 && ", "}
                    <a href={localePath(tr.data.lang, `/ecrits/${baseSlug(tr)}`)} hreflang={tr.data.lang} lang={tr.data.lang}>
                      {dict.lang.switchTo[tr.data.lang]}
                    </a>
                  </Fragment>
                ))}
              </p>
            )
          }
        </div>
      </PageHead>
    </div>

    {
      data.image && (
        <figure class="measure post-cover">
          <Image src={data.image} alt={data.imageAlt ?? ""} widths={[480, 800, 1200]} sizes="(max-width: 768px) 100vw, 64ch" />
        </figure>
      )
    }

    <div class="measure prose crqpt-compat">
      <Content />
    </div>

    <p class="measure post-end">
      <a class="post-back" href={back}><Arrow dir="left" />{e.back}</a>
    </p>
  </article>
</BaseLayout>

<style>
  .post-col,
  .post-cover,
  .prose,
  .post-end {
    margin-inline: auto;
  }
  .post-back {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: var(--tap);
    margin-top: clamp(1rem, 3svh, 2rem);
    font-size: var(--fs-small);
    color: var(--ink-3);
    text-decoration: none;
  }
  .post-back:hover,
  .post-back:focus-visible {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .post :global(.page-head) {
    padding-top: 0.5rem;
  }
  .post-meta {
    display: grid;
    gap: 0.35rem;
  }
  .post-meta p {
    margin: 0;
  }
  .post-by {
    color: var(--ink-2);
  }
  .post-dates,
  .post-tags,
  .post-translations {
    font-family: var(--mono);
    font-size: var(--fs-meta);
    line-height: var(--lh-mono);
    letter-spacing: var(--ls-mono);
    color: var(--ink-3);
  }
  .post-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin: 0;
    padding: 0;
  }
  .post-cover {
    margin-top: var(--block-gap);
    margin-bottom: 0;
  }
  .post-cover :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--r-3);
  }
  .prose {
    margin-top: var(--block-gap);
  }
  .post-end {
    margin-top: var(--section-gap);
    margin-bottom: 0;
  }
</style>
