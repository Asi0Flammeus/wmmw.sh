---
import { Image } from "astro:assets";
import { render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import { type Locale, t, localePath, formatDate } from "@i18n/index";
import { baseSlug, translationsOf, type Writing } from "@lib/writings";
import "@styles/crqpt-compat.css";

interface Props {
  locale: Locale;
  entry: Writing;
}

const { locale, entry } = Astro.props;
const dict = t(locale);
const { data } = entry;
const slug = baseSlug(entry);
const translations = await translationsOf(entry);
const { Content } = await render(entry);
---

<BaseLayout
  locale={locale}
  title={data.title}
  description={data.description}
  path={`/ecrits/${slug}`}
  ogImage={data.image ? data.image.src : undefined}
>
  <article class="post">
    <p class="post-back">
      <a href={localePath(locale, "/ecrits")}>{dict.ecrits.back}</a>
    </p>

    <header class="post-head">
      <p class="post-path">{dict.ecrits.readingDir}{slug}.md</p>
      <p class="post-meta">
        <span>{dict.ecrits.published} {formatDate(data.publishedAt, locale)}</span>
        {
          data.updatedAt && (
            <span class="post-meta-sep">
              {dict.ecrits.updated} {formatDate(data.updatedAt, locale)}
            </span>
          )
        }
      </p>
      {
        data.tags.length > 0 && (
          <ul class="post-tags">
            {data.tags.map((tag) => (
              <li>#{tag}</li>
            ))}
          </ul>
        )
      }
      {
        translations.length > 0 && (
          <p class="post-translations">
            {dict.ecrits.translations}{" "}
            {translations.map((tr, i) => (
              <Fragment>
                {i > 0 && <span class="sep">, </span>}
                <a href={localePath(tr.data.lang, `/ecrits/${baseSlug(tr)}`)}>
                  {dict.lang.switchTo[tr.data.lang]}
                </a>
              </Fragment>
            ))}
          </p>
        )
      }
    </header>

    {
      data.image && (
        <figure class="post-cover">
          <Image
            src={data.image}
            alt={data.imageAlt ?? ""}
            widths={[480, 800, 1200]}
            sizes="(max-width: 768px) 100vw, 65ch"
          />
        </figure>
      )
    }

    <div class="prose crqpt-compat">
      <Content />
    </div>

    <p class="post-back post-back-end">
      <a href={localePath(locale, "/ecrits")}>{dict.ecrits.back}</a>
    </p>
  </article>
</BaseLayout>

<style>
  /* ---------- post shell (readable measure) ---------- */
  .post {
    max-width: 65ch;
    margin-inline: auto;
    padding: clamp(2.5rem, 6vw, 4.5rem) var(--pad) 5rem;
  }

  /* ---------- terminal-flavored back nav ---------- */
  .post-back {
    font-family: var(--mono);
    font-size: 0.85rem;
    margin-bottom: 2rem;
  }
  .post-back a {
    color: var(--ink-3);
    text-decoration: none;
  }
  .post-back a::before {
    content: "$ ";
    color: var(--ink-3);
  }
  .post-back a:hover,
  .post-back a:focus-visible {
    color: var(--accent);
  }
  .post-back-end {
    margin-top: 3rem;
    margin-bottom: 0;
  }

  /* ---------- mono metadata header ---------- */
  .post-head {
    margin-bottom: 2.4rem;
  }
  .post-path {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--ink-3);
    margin-bottom: 1rem;
  }
  .post-meta {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--ink-3);
    margin-bottom: 1rem;
  }
  .post-meta-sep::before {
    content: " · ";
  }
  .post-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 0 0 1rem;
  }
  .post-tags li {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--ink-3);
    border: 1px solid var(--hair);
    border-radius: var(--r-pill);
    padding: 0.2rem 0.65rem;
  }
  .post-translations {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--ink-3);
  }
  .post-translations a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }
  .post-translations a:hover,
  .post-translations a:focus-visible {
    border-bottom-color: var(--accent);
  }

  /* ---------- cover ---------- */
  .post-cover {
    margin: 0 0 2.6rem;
  }
  .post-cover :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--r-tile);
  }

  /* ---------- article body (MDX renders here; needs :global) ---------- */
  .prose {
    color: var(--bone);
    font-family: var(--body);
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  .prose :global(h2) {
    font-family: var(--disp);
    font-weight: 500;
    font-size: clamp(1.5rem, 3vw, 1.9rem);
    letter-spacing: -0.02em;
    line-height: 1.2;
    text-wrap: balance;
    color: var(--bone);
    margin: 2.6rem 0 1rem;
  }
  .prose :global(h3) {
    font-family: var(--disp);
    font-weight: 500;
    font-size: 1.3rem;
    line-height: 1.25;
    color: var(--bone);
    margin: 2rem 0 0.8rem;
  }
  .prose :global(h4) {
    font-family: var(--disp);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--bone);
    margin: 1.6rem 0 0.6rem;
  }
  .prose :global(p) {
    margin: 0 0 1.2rem;
  }
  .prose :global(a) {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }
  .prose :global(a:hover),
  .prose :global(a:focus-visible) {
    border-bottom-color: var(--accent);
  }
  .prose :global(strong) {
    color: var(--bone);
    font-weight: 700;
  }
  .prose :global(em) {
    font-style: italic;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.2rem;
    padding-left: 1.4rem;
  }
  .prose :global(li) {
    margin: 0 0 0.4rem;
  }
  .prose :global(li::marker) {
    color: var(--ink-3);
  }
  .prose :global(blockquote) {
    margin: 1.6rem 0;
    padding: 0.2rem 0 0.2rem 1.2rem;
    border-left: 2px solid var(--hair);
    color: var(--ink-2);
    font-style: italic;
  }
  .prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }
  .prose :global(code) {
    font-family: var(--mono);
    font-size: 0.9em;
    background: var(--surf);
    border: 1px solid var(--hair);
    border-radius: 4px;
    padding: 0.1em 0.35em;
  }
  .prose :global(pre) {
    font-family: var(--mono);
    font-size: 0.875rem;
    line-height: 1.6;
    background: var(--surf);
    border: 1px solid var(--hair);
    border-radius: var(--r-tile);
    padding: 1rem 1.2rem;
    overflow-x: auto;
    margin: 0 0 1.4rem;
  }
  .prose :global(pre code) {
    background: none;
    border: 0;
    padding: 0;
    font-size: inherit;
  }
  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--hair);
    margin: 2.4rem 0;
  }
  .prose :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: var(--r-tile);
    margin: 1.6rem auto;
  }
  .prose :global(figure) {
    margin: 1.6rem 0;
  }
  .prose :global(figcaption) {
    color: var(--ink-3);
    font-size: 0.85rem;
    text-align: center;
    margin-top: 0.5rem;
  }
  .prose :global(table) {
    display: block;
    width: 100%;
    border-collapse: collapse;
    font-family: var(--mono);
    font-size: 0.85rem;
    overflow-x: auto;
    margin: 0 0 1.4rem;
  }
  .prose :global(th),
  .prose :global(td) {
    border: 1px solid var(--hair);
    padding: 0.5rem 0.7rem;
    text-align: left;
  }
  .prose :global(th) {
    color: var(--bone);
    font-weight: 600;
    background: var(--surf);
  }
  .prose :global(td) {
    color: var(--ink-2);
  }
</style>
