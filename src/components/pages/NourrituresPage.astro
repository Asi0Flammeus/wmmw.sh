---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import TerminalPanel from "@components/TerminalPanel.astro";
import TermCmd from "@components/TermCmd.astro";
import { type Locale, t } from "@i18n/index";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const tabs = dict.nourritures.tabs;

const all = await getCollection("nourritures");
const byType = (type: "livre" | "film" | "video") =>
  all
    .filter((entry) => entry.data.type === type)
    .sort((a, b) => a.data.order - b.data.order);

const livres = byType("livre");
const films = byType("film");
const videos = byType("video");

/* The first book carries the page's single paper surface. It stays in the
   listing below: `cat -n` must print the whole file. */
const featured = livres[0];
---

<BaseLayout
  locale={locale}
  title={dict.nourritures.heading}
  description={dict.meta.nourritures}
  path="/nourritures"
>
  <section class="sec offset-l" data-block>
    <div class="wrap">
      <div class="sec-inner">
        {
          featured && (
            <div class="feat reveal">
              <TerminalPanel
                path="~/nourritures/livres.txt"
                variant="paper"
                depth={10}
                rot={2.2}
                d={140}
              >
                <p class="paper-label">{dict.nourritures.featured}</p>
                <h2 class="feat-title">{featured.data.title}</h2>
                <p class="feat-author">{featured.data.author}</p>
              </TerminalPanel>
            </div>
          )
        }

        <TerminalPanel path="~/nourritures" depth={5} rot={0} d={240}>
          <p class="c intro">{dict.nourritures.intro}</p>

          <div class="tabs" data-tabs data-tabs-label={dict.nourritures.heading}>
            <section class="tabsec" data-tab="livres">
              <h2 class="tabhead">{tabs.livres}</h2>
              <TermCmd command={dict.nourritures.cmdBooks} />
              <div class="out" data-step="fade">
                <ol class="books">
                  {
                    livres.map((entry, i) => (
                      <li>
                        <span class="n" aria-hidden="true">{i + 1}</span>
                        <span class="a">{entry.data.author},</span>{" "}
                        <em>{entry.data.title}</em>
                      </li>
                    ))
                  }
                </ol>
              </div>
            </section>

            <section class="tabsec" data-tab="films">
              <h2 class="tabhead">{tabs.films}</h2>
              <TermCmd command="ls nourritures/films/" />
              <div class="out" data-step="fade">
                {
                  films.length === 0 ? (
                    <p class="c">{dict.nourritures.empty}</p>
                  ) : (
                    <ol class="books">
                      {films.map((entry, i) => (
                        <li>
                          <span class="n" aria-hidden="true">{i + 1}</span>
                          <span class="a">{entry.data.author},</span>{" "}
                          <em>{entry.data.title}</em>
                        </li>
                      ))}
                    </ol>
                  )
                }
              </div>
            </section>

            <section class="tabsec" data-tab="videos">
              <h2 class="tabhead">{tabs.videos}</h2>
              <TermCmd command="ls nourritures/videos/" />
              <div class="out" data-step="fade">
                {
                  videos.length === 0 ? (
                    <p class="c">{dict.nourritures.empty}</p>
                  ) : (
                    <ol class="books">
                      {videos.map((entry, i) => (
                        <li>
                          <span class="n" aria-hidden="true">{i + 1}</span>
                          <span class="a">{entry.data.author},</span>{" "}
                          <em>{entry.data.title}</em>
                        </li>
                      ))}
                    </ol>
                  )
                }
              </div>
            </section>
          </div>
        </TerminalPanel>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- promoted book: the page's single paper surface ---------- */
  .feat {
    margin-bottom: clamp(2rem, 4vw, 3.2rem);
  }
  .feat-title {
    font-style: italic;
  }
  .feat-author {
    max-width: 40ch;
  }

  .intro {
    margin-bottom: 0.4rem;
  }

  /* no-JS / reduced fallback: stacked sections with mono headers */
  .tabhead {
    font-family: var(--mono);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--bone);
    margin-top: 1.8rem;
  }
  .tabsec:first-of-type .tabhead {
    margin-top: 0.8rem;
  }

  /* ---------- enhanced tablist: a small dock of glass pills ----------
     Built by the script below, so the selectors go through the authored .tabs
     container: generated nodes carry no astro scope attribute. The pills are
     lit by the shared specular driver through data-spec, set in the script.
     Sizes are floored so the narrow --u rebase cannot shrink a control below
     a usable touch target or a readable label. */
  .tabs :global(.tablist) {
    display: flex;
    flex-wrap: wrap;
    gap: max(6px, calc(8 * var(--u)));
    margin: 1.4rem 0 1.6rem;
  }
  .tabs :global(.tab) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: max(14px, calc(18 * var(--u)));
    font-family: var(--mono);
    font-size: max(10px, calc(11 * var(--u)));
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--ink-faint);
    cursor: pointer;
    border-radius: var(--r-pill);
    background:
      linear-gradient(180deg, rgba(232, 226, 213, 0.055), rgba(232, 226, 213, 0) 42%),
      rgba(26, 23, 18, 0.74);
    border: 1px solid rgba(232, 226, 213, 0.11);
    box-shadow:
      0 calc(8 * var(--u)) calc(22 * var(--u)) rgba(8, 7, 5, 0.34),
      inset 0 1px rgba(232, 226, 213, 0.06);
  }
  .tabs :global(.tab:hover) {
    color: var(--bone);
    border-color: rgba(232, 226, 213, 0.2);
  }
  .tabs :global(.tab[aria-selected="true"]) {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  :global(html.anim) .tabs :global(.tab) {
    transition:
      color 0.4s var(--ease),
      border-color 0.4s var(--ease),
      background 0.4s var(--ease);
  }

  .books {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .books li {
    color: var(--ink-2);
  }
  .books .n {
    display: inline-block;
    width: 4ch;
    text-align: right;
    margin-right: 2.5ch;
    color: var(--ink-3);
  }
  .books .a {
    color: var(--ink-2);
  }
  .books em {
    color: var(--bone);
    font-style: italic;
  }

  @media (max-width: 767px) {
    .books .n {
      width: 3ch;
      margin-right: 1.5ch;
    }
  }
</style>

<script>
  /* Nourritures tabs: progressive enhancement to an ARIA tablist.
     No-JS keeps every section stacked and visible. */
  document.querySelectorAll<HTMLElement>("[data-tabs]").forEach((root) => {
    const secs = Array.from(
      root.querySelectorAll<HTMLElement>("[data-tab]"),
    );
    if (secs.length === 0) return;

    const tablist = document.createElement("div");
    tablist.className = "tablist";
    tablist.setAttribute("role", "tablist");
    const label = root.dataset.tabsLabel;
    if (label) tablist.setAttribute("aria-label", label);

    const btns: HTMLButtonElement[] = [];
    secs.forEach((sec) => {
      const key = sec.dataset.tab ?? "";
      const head = sec.querySelector<HTMLElement>(".tabhead");
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "tab";
      btn.id = `tab-${key}`;
      btn.textContent = head ? head.textContent : key;
      btn.setAttribute("role", "tab");
      btn.setAttribute("aria-controls", `panel-${key}`);
      /* Specular rim: initSpec() collects [data-spec] on astro:page-load,
         which fires after this script, so the fresh pills are picked up. */
      btn.setAttribute("data-spec", "");

      sec.id = `panel-${key}`;
      sec.setAttribute("role", "tabpanel");
      sec.setAttribute("aria-labelledby", `tab-${key}`);
      sec.setAttribute("tabindex", "0");
      if (head) head.hidden = true;

      btns.push(btn);
      tablist.appendChild(btn);
    });

    root.insertBefore(tablist, root.firstChild);

    /* When a panel is revealed, force any pending typing/fade to its final
       state: the shared typing engine may have run (or blanked commands)
       while the panel was hidden. */
    const finalize = (sec: HTMLElement) => {
      sec
        .querySelectorAll<HTMLElement>(".cmd-text")
        .forEach((span) => {
          if (span.dataset.full != null) span.textContent = span.dataset.full;
        });
      sec.querySelectorAll<HTMLElement>("[data-step]").forEach((el) => {
        el.classList.remove("typing");
        el.classList.add("on", "done");
      });
    };

    const select = (idx: number, focus: boolean) => {
      btns.forEach((btn, i) => {
        const on = i === idx;
        btn.setAttribute("aria-selected", on ? "true" : "false");
        btn.tabIndex = on ? 0 : -1;
        const sec = secs[i];
        if (sec) sec.hidden = !on;
      });
      const shown = secs[idx];
      if (shown) finalize(shown);
      const active = btns[idx];
      if (focus && active) active.focus();
    };

    tablist.addEventListener("click", (e) => {
      const target = (e.target as HTMLElement).closest(".tab");
      const idx = btns.indexOf(target as HTMLButtonElement);
      if (idx >= 0) select(idx, false);
    });

    tablist.addEventListener("keydown", (e) => {
      const cur = btns.findIndex((b) => b.tabIndex === 0);
      let next = -1;
      switch (e.key) {
        case "ArrowRight":
        case "ArrowDown":
          next = (cur + 1) % btns.length;
          break;
        case "ArrowLeft":
        case "ArrowUp":
          next = (cur - 1 + btns.length) % btns.length;
          break;
        case "Home":
          next = 0;
          break;
        case "End":
          next = btns.length - 1;
          break;
      }
      if (next >= 0) {
        e.preventDefault();
        select(next, true);
      }
    });

    select(0, false);
  });
</script>
