---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import { type Locale, t } from "@i18n/index";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const tabs = dict.nourritures.tabs;

const all = await getCollection("nourritures");
const byType = (type: "livre" | "film" | "video") =>
  all
    .filter((entry) => entry.data.type === type)
    .sort((a, b) => a.data.order - b.data.order);

const groups = [
  { key: "livres", label: tabs.livres, entries: byType("livre") },
  { key: "films", label: tabs.films, entries: byType("film") },
  { key: "videos", label: tabs.videos, entries: byType("video") },
];
---

<BaseLayout
  locale={locale}
  title={dict.nourritures.heading}
  description={dict.meta.nourritures}
  path="/nourritures"
>
  <section class="sec offset-l" data-block>
    <div class="wrap">
      <div class="sec-inner">
        <p class="sec-intro reveal">{dict.nourritures.intro}</p>

        <div
          class="tabs reveal"
          data-tabs
          data-tabs-label={dict.nourritures.heading}
        >
          {
            groups.map((group) => (
              <section class="tabsec" data-tab={group.key}>
                <h2 class="tabhead">{group.label}</h2>
                {group.entries.length === 0 ? (
                  <p class="empty">{dict.nourritures.empty}</p>
                ) : (
                  <ol class="books">
                    {group.entries.map((entry, i) => (
                      <li>
                        <span class="n" aria-hidden="true">
                          {i + 1}
                        </span>
                        <span class="a">{entry.data.author},</span>{" "}
                        <em>{entry.data.title}</em>
                      </li>
                    ))}
                  </ol>
                )}
              </section>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .tabs {
    margin-top: 2.2rem;
  }

  /* no-JS / reduced fallback: stacked sections with plain headers */
  .tabhead {
    font-family: var(--disp);
    font-weight: 500;
    font-size: var(--fs-h3);
    letter-spacing: -0.01em;
    color: var(--bone);
    margin-top: 2.2rem;
    margin-bottom: 1.2rem;
  }
  .tabsec:first-of-type .tabhead {
    margin-top: 0;
  }

  /* enhanced tablist (built by the script; scoped via the authored .tabs
     container since the generated nodes carry no astro scope attribute) */
  .tabs :global(.tablist) {
    display: flex;
    gap: 0.5rem;
    margin: 0 0 1.8rem;
    flex-wrap: wrap;
  }
  .tabs :global(.tab) {
    font-family: var(--disp);
    font-size: 0.88rem;
    font-weight: 500;
    background: none;
    color: var(--ink-3);
    padding: 0.35rem 1rem;
    cursor: pointer;
    border: 1px solid var(--hair);
    border-radius: var(--r-pill);
  }
  .tabs :global(.tab:hover) {
    color: var(--bone);
  }
  .tabs :global(.tab[aria-selected="true"]) {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .empty {
    color: var(--ink-3);
  }

  .books {
    list-style: none;
    display: flex;
    flex-direction: column;
  }
  .books li {
    color: var(--ink-2);
    padding-block: 0.75rem;
    border-top: 1px solid var(--hair-2);
  }
  .books li:last-child {
    border-bottom: 1px solid var(--hair-2);
  }
  .books .n {
    display: inline-block;
    width: 3ch;
    margin-right: 1.5ch;
    font-family: var(--mono);
    font-size: var(--fs-meta);
    color: var(--ink-3);
  }
  .books .a {
    color: var(--ink-2);
  }
  .books em {
    color: var(--bone);
    font-style: italic;
  }
</style>

<script>
  /* Nourritures tabs: progressive enhancement to an ARIA tablist.
     No-JS keeps every section stacked and visible. */
  document.querySelectorAll<HTMLElement>("[data-tabs]").forEach((root) => {
    const secs = Array.from(root.querySelectorAll<HTMLElement>("[data-tab]"));
    if (secs.length === 0) return;

    const tablist = document.createElement("div");
    tablist.className = "tablist";
    tablist.setAttribute("role", "tablist");
    const label = root.dataset.tabsLabel;
    if (label) tablist.setAttribute("aria-label", label);

    const btns: HTMLButtonElement[] = [];
    secs.forEach((sec) => {
      const key = sec.dataset.tab ?? "";
      const head = sec.querySelector<HTMLElement>(".tabhead");
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "tab";
      btn.id = `tab-${key}`;
      btn.textContent = head ? head.textContent : key;
      btn.setAttribute("role", "tab");
      btn.setAttribute("aria-controls", `panel-${key}`);

      sec.id = `panel-${key}`;
      sec.setAttribute("role", "tabpanel");
      sec.setAttribute("aria-labelledby", `tab-${key}`);
      sec.setAttribute("tabindex", "0");
      if (head) head.hidden = true;

      btns.push(btn);
      tablist.appendChild(btn);
    });

    root.insertBefore(tablist, root.firstChild);

    const select = (idx: number, focus: boolean) => {
      btns.forEach((btn, i) => {
        const on = i === idx;
        btn.setAttribute("aria-selected", on ? "true" : "false");
        btn.tabIndex = on ? 0 : -1;
        const sec = secs[i];
        if (sec) sec.hidden = !on;
      });
      const active = btns[idx];
      if (focus && active) active.focus();
    };

    tablist.addEventListener("click", (e) => {
      const target = (e.target as HTMLElement).closest(".tab");
      const idx = btns.indexOf(target as HTMLButtonElement);
      if (idx >= 0) select(idx, false);
    });

    tablist.addEventListener("keydown", (e) => {
      const cur = btns.findIndex((b) => b.tabIndex === 0);
      let next = -1;
      switch (e.key) {
        case "ArrowRight":
        case "ArrowDown":
          next = (cur + 1) % btns.length;
          break;
        case "ArrowLeft":
        case "ArrowUp":
          next = (cur - 1 + btns.length) % btns.length;
          break;
        case "Home":
          next = 0;
          break;
        case "End":
          next = btns.length - 1;
          break;
      }
      if (next >= 0) {
        e.preventDefault();
        select(next, true);
      }
    });

    select(0, false);
  });
</script>
