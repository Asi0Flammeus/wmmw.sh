---
import BaseLayout from "@layouts/BaseLayout.astro";
import { type Locale, t, localePath, isoDate } from "@i18n/index";
import { publishedWritings, baseSlug } from "@lib/writings";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const entries = await publishedWritings(locale);
---

<BaseLayout
  locale={locale}
  title={dict.ecrits.heading}
  description={dict.meta.ecrits}
  path="/ecrits"
>
  <section class="sec offset-l" data-block>
    <div class="wrap">
      <div class="sec-inner">
        <p class="sec-intro reveal">{dict.ecrits.intro}</p>
        <div class="rows reveal">
          {
            entries.map((entry) => {
              const slug = baseSlug(entry);
              return (
                <a
                  class="row-item writing"
                  data-myc-node
                  href={localePath(locale, `/ecrits/${slug}`)}
                >
                  <p class="meta-label">
                    <time datetime={isoDate(entry.data.publishedAt)}>
                      {isoDate(entry.data.publishedAt)}
                    </time>
                  </p>
                  <h2 class="writing-title">{entry.data.title}</h2>
                  <p class="writing-hook">{entry.data.description}</p>
                </a>
              );
            })
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .rows {
    margin-top: 2.6rem;
  }
  .writing {
    display: block;
    text-decoration: none;
    color: inherit;
    padding-block: 1.9rem;
  }
  .writing:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 2px;
  }
  .writing-title {
    font-family: var(--disp);
    font-weight: 500;
    font-size: var(--fs-h2);
    letter-spacing: -0.02em;
    line-height: 1.12;
    color: var(--bone);
    margin-top: 0.5rem;
    max-width: 26ch;
    text-wrap: balance;
  }
  .writing:hover .writing-title,
  .writing:focus-visible .writing-title {
    color: var(--accent);
  }
  :global(html.anim) .writing-title {
    transition: color var(--t-base) ease;
  }
  .writing-hook {
    margin-top: 0.6rem;
    color: var(--ink-2);
    max-width: 58ch;
    text-wrap: pretty;
  }
</style>
