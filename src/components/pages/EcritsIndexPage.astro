---
/**
 * /ecrits (spec §7.4, decision A19): the list of writings, then the follow
 * block under it (RSS button and the feed address to copy). Drafts excluded.
 */
import { type Locale, t, localePath } from "@i18n/index";
import { publishedWritings } from "@lib/writings";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHead from "@components/ui/PageHead.astro";
import Button from "@components/ui/Button.astro";
import CopyLine from "@components/outils/CopyLine.astro";
import WritingRow from "@components/ecrits/WritingRow.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const e = t(locale).ecrits;
const entries = await publishedWritings(locale);
const feedPath = localePath(locale, "/rss.xml");
---

<BaseLayout locale={locale} title={e.meta.title} description={e.meta.description} path="/ecrits">
  <div class="wrap">
    <PageHead title={e.heading} lead={e.intro} />
    <ul class="writings">
      {entries.map((entry) => <WritingRow locale={locale} entry={entry} />)}
    </ul>
    <div class="follow">
      <Button variant="secondary" href={feedPath} locale={locale}>{e.follow}</Button>
      <p class="follow-hint">{e.followHint}</p>
      <CopyLine code={`wmmw.sh${feedPath}`} locale={locale} copyLabel={e.copy} copiedLabel={e.copied} label={e.feedLabel} />
    </div>
  </div>
</BaseLayout>

<style>
  .writings {
    list-style: none;
    margin: var(--block-gap) 0 0;
    padding: 0;
    max-width: var(--measure);
  }
  .follow {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    max-width: 30rem;
    margin-top: var(--section-gap);
  }
  .follow :global(.copyline) {
    width: 100%;
  }
  .follow-hint {
    margin: 0.5rem 0 0;
    font-size: var(--fs-small);
    color: var(--ink-2);
  }
</style>
