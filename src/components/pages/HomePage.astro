---
import { getCollection } from "astro:content";
import { type Locale, t, localePath, isoDate } from "@i18n/index";
import { SITE_URL, GITHUB_URL, TERM_USER } from "@lib/site";
import { publishedWritings, baseSlug } from "@lib/writings";
import BaseLayout from "@layouts/BaseLayout.astro";
import TerminalPanel from "@components/TerminalPanel.astro";
import TermCmd from "@components/TermCmd.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const chrome = t(locale);

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const tools = (await getCollection("tools")).sort(
  (a, b) => a.data.order - b.data.order,
);
const writings = (await publishedWritings(locale)).slice(0, 3);

/**
 * The newest writing is the page's single paper spotlight; the other two stay
 * in the dark listing below it, so the post never appears twice.
 */
const spotlight = writings[0];
const listed = writings.slice(1);
const spotlightHref = spotlight
  ? localePath(locale, `/ecrits/${baseSlug(spotlight)}`)
  : "";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "William",
  alternateName: "asi0",
  url: SITE_URL,
  sameAs: [GITHUB_URL],
};

/**
 * Depth ladder and entrance stagger for this page.
 *
 *   section         offset  heading --pd/--pr/--d   panel depth/rot/d
 *   manifeste       l       18 / 1.2 / 60ms         6 / 0.9 / 200ms
 *   projets         r       14 / 1.0 / 150ms        9 / 1.3 / 290ms
 *   outils          l       18 / 1.2 / 240ms        6 / 0.9 / 380ms
 *   ecrits          r       14 / 1.0 / 330ms        paper 10 / 2.4 / 470ms
 *                                                   list  9 / 1.3 / 560ms
 *
 * Two rules behind those numbers:
 *  - Long text and the monospaced tree ride shallow (6): a listing whose glyph
 *    column slides under the cursor reads as a wobble, not as depth. Card grids
 *    ride deeper (9), the paper spotlight deepest.
 *  - Panel depth stays at 10 or less because mycelium.ts measures .panel-head
 *    with the transform applied and only re-measures on rebuild, so a deeper
 *    panel drifts off its filament branch tip. The spotlight gets its "front
 *    card" read from rotation (2.4deg) instead, which pivots about the centre
 *    and barely moves the head.
 *
 * Entrances use the clip-path grammar (.mask on panels, .rise > i on headings)
 * rather than .reveal: html.anim .reveal writes transform: translateY(14px) at
 * a higher specificity than .par, so an element carrying both loses its depth
 * for good. Panel bodies keep their own viewport trigger, the [data-step]
 * sequence driven by term-type.ts and woken by the filament.
 */

/**
 * Home-only manifeste teaser. This prose is home-page content (not chrome and
 * not a reusable collection field), so it lives here as a local per-locale
 * dictionary. FR is verbatim from the design of record (mockup D); EN and ES
 * are faithful translations. No em or en dashes anywhere.
 */
type Teaser = {
  title: string;
  body: string;
  quote: string;
  dimsHeading: string;
  dims: { term: string; desc: string }[];
};

const teaser: Record<Locale, Teaser> = {
  fr: {
    title: "Richesse mycélique",
    body: "Le mycélium ne discrimine pas entre les nutriments. Il transporte ce dont la forêt a besoin. La richesse mycélique, c'est apporter des ressources aux autres comme si ta vie en dépendait, sans exiger de retour. Le retour vient toujours, sous une forme qu'on n'attendait pas.",
    quote:
      "La forêt n'a pas besoin d'un arbre de plus. Elle a besoin de mycélium.",
    dimsHeading: "Les cinq dimensions",
    dims: [
      { term: "Financière", desc: "des liquidités pour soutenir le vivant." },
      { term: "Relationnelle", desc: "la confiance, tissée lien par lien." },
      { term: "Intellectuelle", desc: "le savoir qui circule dans le réseau." },
      { term: "Expérientielle", desc: "les aventures que la forêt produit." },
      { term: "Émotionnelle", desc: "ce que le sol nourrit en silence." },
    ],
  },
  en: {
    title: "Mycelial wealth",
    body: "The mycelium does not discriminate between nutrients. It carries whatever the forest needs. Mycelial wealth means bringing resources to others as if your life depended on it, without demanding anything back. The return always comes, in a form you did not expect.",
    quote: "The forest does not need one more tree. It needs mycelium.",
    dimsHeading: "The five dimensions",
    dims: [
      { term: "Financial", desc: "liquidity to sustain the living." },
      { term: "Relational", desc: "trust, woven link by link." },
      { term: "Intellectual", desc: "knowledge that flows through the network." },
      { term: "Experiential", desc: "the adventures the forest produces." },
      { term: "Emotional", desc: "what the soil nourishes in silence." },
    ],
  },
  es: {
    title: "Riqueza micelial",
    body: "El micelio no discrimina entre los nutrientes. Transporta lo que el bosque necesita. La riqueza micelial consiste en aportar recursos a los demás como si tu vida dependiera de ello, sin exigir nada a cambio. El retorno siempre llega, en una forma que no esperabas.",
    quote: "El bosque no necesita un árbol más. Necesita micelio.",
    dimsHeading: "Las cinco dimensiones",
    dims: [
      { term: "Financiera", desc: "liquidez para sostener lo vivo." },
      { term: "Relacional", desc: "la confianza, tejida enlace a enlace." },
      { term: "Intelectual", desc: "el saber que circula por la red." },
      { term: "Experiencial", desc: "las aventuras que el bosque produce." },
      { term: "Emocional", desc: "lo que el suelo nutre en silencio." },
    ],
  },
};
const tz = teaser[locale];
---

<BaseLayout
  locale={locale}
  title="wmmw.sh"
  description={chrome.meta.home}
  path="/"
  heroVariant="full"
  jsonLd={jsonLd}
>
  <section class="sec offset-l" data-block>
    <div class="wrap">
      <div class="sec-inner">
        <h2 class="disp-h par rise" style="--pd:18;--pr:1.2;--d:60ms">
          <i>
            {chrome.manifeste.heading}{" "}
            <span class="gold">{chrome.manifeste.headingGold}</span>
          </i>
        </h2>
        <TerminalPanel path="~/manifeste" depth={6} rot={0.9} d={200}>
          <TermCmd command={chrome.manifeste.cmd} />
          <div class="out md" data-step="fade">
            <p class="h"><span class="tok"># </span>{tz.title}</p>
            <p>{tz.body}</p>
            <p class="quote"><span class="tok">&gt; </span>{tz.quote}</p>
            <p class="h"><span class="tok">## </span>{tz.dimsHeading}</p>
            <ul>
              {
                tz.dims.map((d) => (
                  <li>
                    <span class="tok">- **</span>
                    <span class="term">{d.term}</span>
                    <span class="tok">**</span> : {d.desc}
                  </li>
                ))
              }
            </ul>
          </div>
          <p class="cmdline chipline" data-step="fade">
            <span class="ps"><b>{TERM_USER}</b>:~$</span>{" "}
            <a
              class="cta-chip glass"
              data-spec
              href={localePath(locale, "/manifeste")}
            >
              {chrome.manifeste.readMore}
            </a>
          </p>
        </TerminalPanel>
      </div>
    </div>
  </section>

  <section class="sec offset-r" data-block>
    <div class="wrap">
      <div class="sec-inner">
        <h2 class="disp-h par rise" style="--pd:14;--pr:1;--d:150ms">
          <i>{chrome.projets.heading}</i>
        </h2>
        <TerminalPanel path="~/projets" depth={9} rot={1.3} d={290}>
          <TermCmd command={chrome.projets.cmd} />
          <div class="out" data-step="fade">
            <p class="c intro">{chrome.projets.intro}</p>
            <div class="plist">
              {
                projects.map((p) => (
                  <div class="prow">
                    <span class="pname">{p.data.name}</span>
                    <p class="pbody">
                      <strong>
                        {p.data.url ? (
                          <a href={p.data.url}>{p.data.title}</a>
                        ) : (
                          p.data.title
                        )}
                      </strong>{" "}
                      {p.data.blurb[locale]}
                    </p>
                  </div>
                ))
              }
            </div>
          </div>
          <p class="cmdline morelink" data-step="fade">
            <span class="ps"><b>{TERM_USER}</b>:~$</span>{" "}
            <a
              class="morechip glass"
              data-spec
              href={localePath(locale, "/projets")}
            >
              {chrome.projets.all}
            </a>
          </p>
        </TerminalPanel>
      </div>
    </div>
  </section>

  <section class="sec offset-l" data-block>
    <div class="wrap">
      <div class="sec-inner">
        <h2 class="disp-h par rise" style="--pd:18;--pr:1.2;--d:240ms">
          <i>{chrome.outils.heading}</i>
        </h2>
        <TerminalPanel path="~/outils" depth={6} rot={0.9} d={380}>
          <TermCmd command={chrome.outils.cmd} />
          <div class="out" data-step="fade">
            <p class="c intro">{chrome.outils.intro}</p>
            <div class="tree">
              <p class="troot">outils/</p>
              {
                tools.map((tool, i) => {
                  const glyph = i === tools.length - 1 ? "└── " : "├── ";
                  const href = tool.data.repo ?? tool.data.url;
                  return (
                    <div class="trow">
                      <span class="tname">
                        <span class="tg">{glyph}</span>
                        {href ? (
                          <a href={href}>{tool.data.name}</a>
                        ) : (
                          tool.data.name
                        )}
                      </span>
                      <span class="tdesc">{tool.data.blurb[locale]}</span>
                    </div>
                  );
                })
              }
            </div>
            <p class="tsum">{chrome.outils.treeSummary(tools.length)}</p>
          </div>
          <p class="cmdline morelink" data-step="fade">
            <span class="ps"><b>{TERM_USER}</b>:~$</span>{" "}
            <a
              class="morechip glass"
              data-spec
              href={localePath(locale, "/outils")}
            >
              {chrome.outils.all}
            </a>
          </p>
        </TerminalPanel>
      </div>
    </div>
  </section>

  <section class="sec offset-r" data-block>
    <div class="wrap">
      <div class="sec-inner">
        <h2 class="disp-h par rise" style="--pd:14;--pr:1;--d:330ms">
          <i>{chrome.ecrits.heading}</i>
        </h2>
        {
          spotlight && (
            <div class="spot">
              <TerminalPanel
                path={`~/ecrits/${baseSlug(spotlight)}.md`}
                variant="paper"
                depth={10}
                rot={2.4}
                d={470}
               
              >
                <p class="paper-label">
                  {chrome.ecrits.published} {isoDate(spotlight.data.publishedAt)}
                </p>
                <h3><a href={spotlightHref}>{spotlight.data.title}</a></h3>
                <p class="hook">{spotlight.data.description}</p>
                <a
                  class="paper-knob"
                  href={spotlightHref}
                  aria-hidden="true"
                  tabindex="-1"
                >
                  <span>-&gt;</span>
                </a>
              </TerminalPanel>
            </div>
          )
        }
        <TerminalPanel path="~/ecrits" depth={9} rot={1.3} d={560}>
          <TermCmd command={chrome.ecrits.cmd} />
          <div class="out" data-step="fade">
            <p class="c intro">{chrome.ecrits.intro}</p>
            <div class="flist">
              {
                listed.map((entry) => {
                  const slug = baseSlug(entry);
                  return (
                    <a
                      class="frow"
                      href={localePath(locale, `/ecrits/${slug}`)}
                    >
                      <p class="fline">
                        <span class="fdir">ecrits/</span>
                        <span class="fname">{slug}.md</span>
                        <span class="lead" aria-hidden="true" />
                        <span class="fdate">
                          {isoDate(entry.data.publishedAt)}
                        </span>
                      </p>
                      <p class="ftitle">{entry.data.title}</p>
                      <p class="fhook c">{entry.data.description}</p>
                    </a>
                  );
                })
              }
            </div>
          </div>
          <p class="cmdline morelink" data-step="fade">
            <span class="ps"><b>{TERM_USER}</b>:~$</span>{" "}
            <a
              class="morechip glass"
              data-spec
              href={localePath(locale, "/ecrits")}
            >
              {chrome.ecrits.all}
            </a>
          </p>
        </TerminalPanel>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- composed display scale ----------
     56u is 56px on the 1440 reference frame, which is above the old 2.9rem cap.
     max() keeps the rem clamp as the floor, so nothing shrinks at 320px. The
     u term is scoped above 900px on purpose: below it tokens.css re-bases u to
     100vw/760 for the hero furniture, which would jump a section heading from
     34px to 66px across the breakpoint. */
  @media (min-width: 901px) {
    .disp-h {
      font-size: max(clamp(1.9rem, 3.8vw, 2.9rem), calc(56 * var(--u)));
    }
  }

  /* the one paper card on the page, and the air it needs above the dark list */
  .spot {
    margin-bottom: clamp(1.6rem, 3vw, 2.6rem);
  }
  /* The knob is absolute in the panel's bottom-right corner, so the last block
     of a paper card must leave it room: body padding plus 40u clears a 46u knob
     sitting 18u off the bottom edge. */
  .hook {
    margin-bottom: max(30px, calc(40 * var(--u)));
  }
  .paper-knob span {
    font-family: var(--mono);
    font-size: 0.95rem;
    font-weight: 600;
  }

  /* ---------- manifeste : markdown-ish cat (ported from mockup D) ---------- */
  .md {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }
  .md .h {
    color: var(--bone);
    font-weight: 700;
  }
  .md .tok {
    color: var(--ink-3);
  }
  .md .quote {
    color: var(--accent);
    font-weight: 600;
  }
  .md ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .md ul li {
    color: var(--ink-2);
  }
  .md ul .term {
    color: var(--accent);
    font-weight: 600;
  }

  /* ---------- trailing action rows ----------
     Both the readMore chip and the quiet "cd <dir>" links wear the header dock
     treatment: .glass for the surface, data-spec for the rim (src/lib/spec.ts
     drives every [data-spec] from the shared pointer bus). Neither rule below
     may set background or border, or it would outrank .glass and flatten it. */
  .chipline,
  .morelink {
    margin-top: 1.8rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9ch;
  }
  .cta-chip,
  .morechip {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.95em;
    border-radius: var(--r-tile);
    font-family: var(--mono);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
  }
  .cta-chip {
    color: var(--accent);
  }
  .morechip {
    font-weight: 500;
    color: var(--ink-3);
  }
  html.anim .cta-chip,
  html.anim .morechip {
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }
  .cta-chip:hover,
  .cta-chip:focus-visible {
    background: var(--accent);
    color: var(--bg);
  }
  .morechip:hover,
  .morechip:focus-visible {
    color: var(--accent);
  }
  .cta-chip:active,
  .morechip:active {
    transform: translateY(1px);
  }

  /* ---------- projets : aligned 2-col ls ---------- */
  .plist {
    display: grid;
    gap: 1.9rem;
  }
  .prow {
    display: grid;
    grid-template-columns: 22ch 1fr;
    column-gap: 2.5ch;
    align-items: baseline;
  }
  .pname {
    color: var(--accent);
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .pbody {
    color: var(--ink-2);
  }
  .pbody strong {
    display: block;
    color: var(--bone);
    font-weight: 700;
  }
  .pbody strong a,
  .tname a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--hair);
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }
  .pbody strong a:hover,
  .pbody strong a:focus-visible,
  .tname a:hover,
  .tname a:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* ---------- outils : box-drawing tree ---------- */
  .tree {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .troot {
    color: var(--bone);
    font-weight: 700;
  }
  .trow {
    display: grid;
    grid-template-columns: 26ch 1fr;
    column-gap: 2ch;
    align-items: baseline;
  }
  .tg {
    color: var(--ink-3);
  }
  .tname {
    color: var(--accent);
    font-weight: 600;
    white-space: pre;
  }
  .tdesc {
    color: var(--ink-2);
  }
  .tsum {
    margin-top: 1.3rem;
    color: var(--ink-3);
  }

  /* ---------- ecrits : dotted leader + right-aligned dates ---------- */
  .flist {
    display: grid;
    gap: 2.1rem;
  }
  .frow {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .frow:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 2px;
  }
  .fline {
    display: flex;
    align-items: baseline;
    gap: 1ch;
    min-width: 0;
  }
  .fdir {
    color: var(--ink-3);
  }
  .fname {
    color: var(--accent);
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .lead {
    flex: 1;
    min-width: 3ch;
    border-bottom: 1px dotted var(--hair);
    transform: translateY(-0.3em);
  }
  .fdate {
    color: var(--ink-2);
  }
  .ftitle {
    color: var(--bone);
    font-weight: 700;
    margin-top: 0.3rem;
    transition: color 0.2s ease;
  }
  .frow:hover .ftitle,
  .frow:focus-visible .ftitle {
    color: var(--accent);
  }
  .fhook {
    max-width: 58ch;
  }

  /* ---------- single-column collapse ---------- */
  @media (max-width: 767px) {
    .prow {
      grid-template-columns: 1fr;
      row-gap: 0.25rem;
    }
    .trow {
      grid-template-columns: 1fr;
      row-gap: 0.1rem;
    }
    .trow .tdesc {
      padding-left: 4ch;
    }
  }
</style>
