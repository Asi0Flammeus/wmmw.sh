---
/**
 * Home, pre-transfer stub (WP1a). It only reads ui.ts keys, writings.ts and
 * the shared stubs, so no other package's namespace or collection change can
 * break it. WP2 rewrites this file (hero with W1, running rows, work block,
 * writings, Mycelic line) against ns/home.ts.
 */
import { type Locale, t, localePath, isoDate } from "@i18n/index";
import { BRAND_NAME, ALYSIS_URL, PLANB_URL } from "@lib/site";
import { publishedWritings, baseSlug } from "@lib/writings";
import { homeJsonLd } from "@lib/jsonld";
import BaseLayout from "@layouts/BaseLayout.astro";
import Arrow from "@components/ui/Arrow.astro";
import Chip from "@components/ui/Chip.astro";
import StepsLine from "@components/visual/StepsLine.astro";
import GhostsNotify from "@components/intake/GhostsNotify.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const writings = (await publishedWritings(locale)).slice(0, 3);

/* Deck §3 and §13.1 strings, local until WP2 lands ns/home.ts. */
const COPY = {
  fr: {
    title: "William Moiré · Développeur indépendant, outils sur mesure",
    description:
      "William Moiré, aussi connu comme asi0. Physicien devenu développeur indépendant : sites, outils sur mesure, éducation Bitcoin libre.",
    sub: "Faisons circuler le savoir, la pratique et la valeur.",
    aside: "Physicien devenu développeur indépendant. Aussi connu comme asi0.",
    now: "En ce moment",
    rows: [
      { name: "Plan ₿ Academy", line: "Le savoir Bitcoin, libre, dans ta langue. J’en maintiens les cours." },
      { name: "alysis", line: "Des sites faits main pour des métiers faits main." },
      { name: "Outils sur mesure", line: "Un logiciel pour une seule personne ? C’est exactement ma taille." },
      { name: "Ghosts", line: "Des agents au très long cours. J’en dis plus bientôt." },
    ],
    work: "Travailler ensemble",
    workLine: "Raconte-moi ce qui coince. Je te dis franchement si je peux aider.",
  },
  en: {
    title: "William Moiré · Independent developer, custom tools",
    description:
      "William Moiré, also known as asi0. Physicist turned independent developer: websites, custom tools, free Bitcoin education.",
    sub: "Let’s keep knowledge, practice and value moving.",
    aside: "Physicist turned independent developer. Also known as asi0.",
    now: "Right now",
    rows: [
      { name: "Plan ₿ Academy", line: "Free Bitcoin knowledge, in your language. I maintain the courses." },
      { name: "alysis", line: "Handmade websites for handmade trades." },
      { name: "Custom tools", line: "Software for one person? That’s exactly my size." },
      { name: "Ghosts", line: "Agents built for the very long run. More soon." },
    ],
    work: "Work together",
    workLine: "Tell me what’s stuck. I’ll tell you honestly if I can help.",
  },
  es: {
    title: "William Moiré · Desarrollador independiente, herramientas a medida",
    description:
      "William Moiré, también conocido como asi0. Físico convertido en desarrollador independiente: webs, herramientas a medida, educación Bitcoin libre.",
    sub: "Hagamos circular el saber, la práctica y el valor.",
    aside: "Físico convertido en desarrollador independiente. También conocido como asi0.",
    now: "Ahora mismo",
    rows: [
      { name: "Plan ₿ Academy", line: "El saber Bitcoin, libre, en tu idioma. Mantengo sus cursos." },
      { name: "alysis", line: "Webs hechas a mano para oficios hechos a mano." },
      { name: "Herramientas a medida", line: "¿Un software para una sola persona? Es justo mi talla." },
      { name: "Ghosts", line: "Agentes de muy largo recorrido. Pronto contaré más." },
    ],
    work: "Trabajar juntos",
    workLine: "Cuéntame qué se atasca. Te diré con franqueza si puedo ayudar.",
  },
} as const;
const copy = COPY[locale];
const [planb, alysis, tools, ghosts] = copy.rows;
const rows = [
  { ...planb, href: PLANB_URL, external: true },
  { ...alysis, href: ALYSIS_URL, external: true },
  { ...tools, href: `${localePath(locale, "/contact")}?chemin=outil`, external: false },
];
---

<BaseLayout
  locale={locale}
  title={copy.title}
  rawTitle
  description={copy.description}
  path="/"
  jsonLd={homeJsonLd(locale)}
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <h1 id="hero-title" class="hero-name">{BRAND_NAME}</h1>
      <p class="hero-sub">{copy.sub}</p>
      <p class="hero-aside mono">{copy.aside}</p>
    </div>
  </section>

  <div class="wrap">
    <section class="now" aria-labelledby="now">
      <h2 id="now" data-qa="now-heading">{copy.now}</h2>
      <ul class="now-rows" role="list">
        {
          rows.map((row) => (
            <li>
              <a
                class="now-row"
                href={row.href}
                rel={row.external ? "noopener" : undefined}
                data-qa="now-row"
              >
                <span class="now-name">{row.name}</span>
                <span class="now-line">{row.line}</span>
                <Arrow dir={row.external ? "external" : "right"} />
                {row.external && <span class="sr">{dict.a11y.external}</span>}
              </a>
            </li>
          ))
        }
        {
          ghosts && (
            <li class="now-row now-ghosts" data-qa="now-row">
              <span class="now-name">{ghosts.name}</span>
              <div class="now-line">
                {ghosts.line}
                <GhostsNotify locale={locale} page="/" />
              </div>
            </li>
          )
        }
      </ul>
    </section>

    <div class="split home-split">
      <section class="work" aria-labelledby="work" data-steps-host>
        <h2 id="work">{copy.work}</h2>
        <p class="work-line">{copy.workLine}</p>
        <StepsLine locale={locale} variant="compact" />
        <div class="chips">
          <Chip href={`${localePath(locale, "/contact")}?chemin=outil`} locale={locale}>
            {dict.paths.tool.me}
          </Chip>
          <Chip href={ALYSIS_URL} locale={locale} external>{dict.paths.site.me}</Chip>
          <Chip href={`${localePath(locale, "/contact")}?chemin=ouvert`} locale={locale}>
            {dict.paths.open.me}
          </Chip>
          <Chip href={`${localePath(locale, "/contact")}?chemin=autre`} locale={locale}>
            {dict.paths.other.me}
          </Chip>
        </div>
      </section>

      <section class="writings" aria-labelledby="ecrits">
        <h2 id="ecrits">{dict.nav.ecrits}</h2>
        <ul class="writing-rows" role="list">
          {
            writings.map((entry) => (
              <li>
                <a class="writing-row" href={localePath(locale, `/ecrits/${baseSlug(entry)}`)}>
                  <time class="meta-label" datetime={isoDate(entry.data.publishedAt)}>
                    {isoDate(entry.data.publishedAt)}
                  </time>
                  <span class="writing-title">{entry.data.title}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="all">
          <a href={localePath(locale, "/ecrits")}>
            {dict.common.allWritings}
            <Arrow dir="right" />
          </a>
        </p>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(1.25rem, 4svh, 2rem) clamp(1.75rem, 5svh, 2.5rem);
  }
  @media (min-width: 768px) {
    .hero {
      margin-top: calc(-1 * var(--header-h));
      padding-block: calc(var(--header-h) + clamp(1.5rem, 7svh, 6rem)) clamp(1.75rem, 6svh, 4.5rem);
    }
  }
  .hero-name {
    margin: 0;
    font-size: var(--fs-hero);
    line-height: var(--lh-hero);
    white-space: nowrap;
  }
  @media (max-width: 560px) {
    .hero-name {
      font-size: var(--fs-hero-narrow);
      line-height: var(--lh-hero-narrow);
      white-space: normal;
    }
  }
  .hero-sub {
    margin-top: 0.5em;
    max-width: 40ch;
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
    letter-spacing: var(--ls-lead);
    text-wrap: balance;
  }
  .hero-aside {
    margin-top: 0.75rem;
    max-width: 64ch;
    color: var(--ink-2);
  }

  .now-rows,
  .writing-rows {
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .now-rows > li,
  .writing-rows > li {
    border-bottom: 1px solid var(--line);
  }
  .now-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 1.5rem;
    align-items: baseline;
    min-height: 4.5rem;
    padding-block: 0.9rem;
    color: var(--ink);
    text-decoration: none;
  }
  @media (min-width: 768px) {
    .now-row {
      grid-template-columns: minmax(10rem, 14rem) minmax(0, 1fr) auto;
    }
  }
  .now-name,
  .writing-title {
    font-family: var(--disp);
    font-feature-settings: "ss01";
    font-size: var(--fs-h3);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-disp);
  }
  .now-line {
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--ink-2);
  }
  @media (max-width: 767px) {
    .now-line {
      grid-column: 1;
    }
    .now-row :global(.arrow) {
      grid-row: 1;
      grid-column: 2;
    }
  }
  .now-row :global(.arrow) {
    color: var(--ink-3);
  }
  .now-row:hover .now-name {
    text-decoration: underline 1px;
    text-underline-offset: 0.18em;
  }

  .home-split {
    margin-top: var(--section-gap);
  }
  .work-line {
    max-width: 46ch;
    color: var(--ink-2);
    margin-bottom: var(--block-gap);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: var(--block-gap);
  }
  .writings {
    margin-top: var(--section-gap);
  }
  @media (min-width: 1100px) {
    .writings {
      margin-top: 0;
    }
  }
  .writing-row {
    display: grid;
    gap: 0.3rem;
    padding-block: 0.9rem;
    color: var(--ink);
    text-decoration: none;
  }
  .all {
    margin-top: 1.25rem;
  }
  .all a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }
</style>
