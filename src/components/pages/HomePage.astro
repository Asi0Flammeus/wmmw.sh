---
import { getCollection } from "astro:content";
import { type Locale, t, localePath, isoDate } from "@i18n/index";
import { SITE_URL, GITHUB_URL } from "@lib/site";
import { publishedWritings, baseSlug } from "@lib/writings";
import BaseLayout from "@layouts/BaseLayout.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const chrome = t(locale);

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const tools = (await getCollection("tools")).sort(
  (a, b) => a.data.order - b.data.order,
);
const writings = (await publishedWritings(locale)).slice(0, 3);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "William",
  alternateName: "asi0",
  url: SITE_URL,
  sameAs: [GITHUB_URL],
};

/**
 * Home-only manifeste teaser. This prose is home-page content (not chrome and
 * not a reusable collection field), so it lives here as a local per-locale
 * dictionary. FR is verbatim from the design of record (mockup D); EN and ES
 * are faithful translations. No em or en dashes anywhere.
 */
type Teaser = {
  title: string;
  body: string;
  quote: string;
  dimsHeading: string;
  dims: { term: string; desc: string }[];
};

const teaser: Record<Locale, Teaser> = {
  fr: {
    title: "Richesse mycélique",
    body: "Le mycélium ne discrimine pas entre les nutriments. Il transporte ce dont la forêt a besoin. La richesse mycélique, c'est apporter des ressources aux autres comme si ta vie en dépendait, sans exiger de retour. Le retour vient toujours, sous une forme qu'on n'attendait pas.",
    quote:
      "La forêt n'a pas besoin d'un arbre de plus. Elle a besoin de mycélium.",
    dimsHeading: "Les cinq dimensions",
    dims: [
      { term: "Financière", desc: "des liquidités pour soutenir le vivant." },
      { term: "Relationnelle", desc: "la confiance, tissée lien par lien." },
      { term: "Intellectuelle", desc: "le savoir qui circule dans le réseau." },
      { term: "Expérientielle", desc: "les aventures que la forêt produit." },
      { term: "Émotionnelle", desc: "ce que le sol nourrit en silence." },
    ],
  },
  en: {
    title: "Mycelial wealth",
    body: "The mycelium does not discriminate between nutrients. It carries whatever the forest needs. Mycelial wealth means bringing resources to others as if your life depended on it, without demanding anything back. The return always comes, in a form you did not expect.",
    quote: "The forest does not need one more tree. It needs mycelium.",
    dimsHeading: "The five dimensions",
    dims: [
      { term: "Financial", desc: "liquidity to sustain the living." },
      { term: "Relational", desc: "trust, woven link by link." },
      { term: "Intellectual", desc: "knowledge that flows through the network." },
      { term: "Experiential", desc: "the adventures the forest produces." },
      { term: "Emotional", desc: "what the soil nourishes in silence." },
    ],
  },
  es: {
    title: "Riqueza micelial",
    body: "El micelio no discrimina entre los nutrientes. Transporta lo que el bosque necesita. La riqueza micelial consiste en aportar recursos a los demás como si tu vida dependiera de ello, sin exigir nada a cambio. El retorno siempre llega, en una forma que no esperabas.",
    quote: "El bosque no necesita un árbol más. Necesita micelio.",
    dimsHeading: "Las cinco dimensiones",
    dims: [
      { term: "Financiera", desc: "liquidez para sostener lo vivo." },
      { term: "Relacional", desc: "la confianza, tejida enlace a enlace." },
      { term: "Intelectual", desc: "el saber que circula por la red." },
      { term: "Experiencial", desc: "las aventuras que el bosque produce." },
      { term: "Emocional", desc: "lo que el suelo nutre en silencio." },
    ],
  },
};
const tz = teaser[locale];
---

<BaseLayout
  locale={locale}
  title="wmmw.sh"
  description={chrome.meta.home}
  path="/"
  heroVariant="full"
  jsonLd={jsonLd}
>
  <section class="sec offset-l" data-block>
    <div class="wrap">
      <div class="sec-inner">
        <div class="sec-head reveal" data-myc-anchor>
          <h2 class="disp-h man-h">
            {chrome.manifeste.heading}{" "}
            <span class="gold">{chrome.manifeste.headingGold}</span>
          </h2>
        </div>
        <div class="manifeste reveal">
          <p class="man-body">{tz.body}</p>
          <h3 class="man-dims-h">{tz.dimsHeading}</h3>
          <dl class="dims">
            {
              tz.dims.map((d) => (
                <div class="dim">
                  <dt>{d.term}</dt>
                  <dd>{d.desc}</dd>
                </div>
              ))
            }
          </dl>
          <p class="sec-more">
            <a class="arrow-link" href={localePath(locale, "/manifeste")}>
              {chrome.manifeste.readMore}
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec offset-r" data-block>
    <div class="wrap">
      <div class="sec-inner">
        <div class="sec-head reveal" data-myc-anchor>
          <h2 class="disp-h">{chrome.projets.heading}</h2>
          <p class="sec-intro">{chrome.projets.intro}</p>
        </div>
        <div class="rows reveal">
          {
            projects.map((p) => (
              <div class="row-item proj">
                <p class="proj-name">
                  {p.data.url ? (
                    <a href={p.data.url}>{p.data.title}</a>
                  ) : (
                    p.data.title
                  )}
                </p>
                <p class="proj-blurb">{p.data.blurb[locale]}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="sec offset-l" data-block>
    <div class="wrap">
      <div class="sec-inner">
        <div class="sec-head reveal" data-myc-anchor>
          <h2 class="disp-h">{chrome.outils.heading}</h2>
          <p class="sec-intro">{chrome.outils.intro}</p>
        </div>
        <div class="rows reveal">
          {
            tools.map((tool) => {
              const href = tool.data.repo ?? tool.data.url;
              return (
                <div class="row-item tool">
                  <p class="tool-name">
                    {href ? <a href={href}>{tool.data.name}</a> : tool.data.name}
                  </p>
                  <p class="tool-blurb">{tool.data.blurb[locale]}</p>
                </div>
              );
            })
          }
        </div>
        <p class="sec-more reveal">
          <a class="arrow-link" href={localePath(locale, "/outils")}>
            {chrome.outils.all}
          </a>
        </p>
      </div>
    </div>
  </section>

  <section class="sec offset-r" data-block>
    <div class="wrap">
      <div class="sec-inner">
        <div class="sec-head reveal" data-myc-anchor>
          <h2 class="disp-h">{chrome.ecrits.heading}</h2>
          <p class="sec-intro">{chrome.ecrits.intro}</p>
        </div>
        <div class="rows reveal">
          {
            writings.map((entry) => {
              const slug = baseSlug(entry);
              return (
                <a
                  class="row-item writing"
                  href={localePath(locale, `/ecrits/${slug}`)}
                >
                  <p class="meta-label">
                    <time datetime={isoDate(entry.data.publishedAt)}>
                      {isoDate(entry.data.publishedAt)}
                    </time>
                  </p>
                  <p class="writing-title">{entry.data.title}</p>
                  <p class="writing-hook">{entry.data.description}</p>
                </a>
              );
            })
          }
        </div>
        <p class="sec-more reveal">
          <a class="arrow-link" href={localePath(locale, "/ecrits")}>
            {chrome.ecrits.all}
          </a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- manifeste : editorial prose + pull quote + definition rows ---------- */
  /* The gold clause breaks onto its own line (asi0 review, 2026-09-04). */
  .man-h .gold {
    display: block;
  }
  .manifeste {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .man-body {
    max-width: 62ch;
    font-size: var(--fs-lead);
    line-height: 1.6;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .man-dims-h {
    font-family: var(--disp);
    font-weight: 500;
    font-size: 1.05rem;
    color: var(--bone);
  }
  .dims {
    display: flex;
    flex-direction: column;
  }
  .dim {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 0.4rem 2rem;
    align-items: baseline;
    padding-block: 0.85rem;
    border-top: 1px solid var(--hair-2);
  }
  .dim:last-child {
    border-bottom: 1px solid var(--hair-2);
  }
  .dim dt {
    font-family: var(--disp);
    font-weight: 500;
    color: var(--accent);
  }
  .dim dd {
    color: var(--ink-2);
  }

  .sec-more {
    margin-top: 2rem;
  }

  /* ---------- projets : name over blurb, ruled ---------- */
  .proj {
    display: grid;
    grid-template-columns: minmax(12rem, 16rem) 1fr;
    gap: 0.4rem 2.5rem;
    align-items: baseline;
  }
  .proj-name {
    font-family: var(--disp);
    font-weight: 500;
    font-size: var(--fs-h3);
    letter-spacing: -0.01em;
    color: var(--bone);
  }
  .proj-name a,
  .tool-name a {
    color: inherit;
    text-decoration: none;
  }
  .proj-name a:hover,
  .proj-name a:focus-visible,
  .tool-name a:hover,
  .tool-name a:focus-visible {
    color: var(--accent);
  }
  .proj-blurb,
  .tool-blurb {
    color: var(--ink-2);
    max-width: 52ch;
    text-wrap: pretty;
  }

  /* ---------- outils : compact rows ---------- */
  .tool {
    display: grid;
    grid-template-columns: minmax(12rem, 16rem) 1fr;
    gap: 0.4rem 2.5rem;
    align-items: baseline;
    padding-block: 1.1rem;
  }
  .tool-name {
    font-family: var(--disp);
    font-weight: 500;
    font-size: 1.1rem;
    color: var(--bone);
  }

  /* ---------- écrits : date, title, hook; whole row clickable ---------- */
  .writing {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .writing:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 2px;
  }
  .writing-title {
    font-family: var(--disp);
    font-weight: 500;
    font-size: var(--fs-h3);
    letter-spacing: -0.01em;
    color: var(--bone);
    margin-top: 0.45rem;
    max-width: 30ch;
    text-wrap: balance;
  }
  .writing:hover .writing-title,
  .writing:focus-visible .writing-title {
    color: var(--accent);
  }
  .writing-hook {
    margin-top: 0.4rem;
    color: var(--ink-2);
    max-width: 58ch;
    text-wrap: pretty;
  }
  :global(html.anim) .writing-title,
  :global(html.anim) .proj-name a,
  :global(html.anim) .tool-name a {
    transition: color var(--t-base) ease;
  }

  /* ---------- single-column collapse ---------- */
  @media (max-width: 767px) {
    .proj,
    .tool {
      grid-template-columns: 1fr;
      row-gap: 0.3rem;
    }
    .dim {
      grid-template-columns: 1fr;
      row-gap: 0.2rem;
    }
  }
</style>
