---
/**
 * Home (spec §7.1): hero with W1, « En ce moment », « Travailler ensemble »
 * beside « Écrits » from 1100 px, then the Mycelic line. No hero CTA, no
 * photo, no primary button: the four chips are the only doors to act.
 */
import { type Locale, t } from "@i18n/index";
import { homeJsonLd } from "@lib/jsonld";
import BaseLayout from "@layouts/BaseLayout.astro";
import HomeHero from "@components/home/HomeHero.astro";
import RunningList from "@components/home/RunningList.astro";
import WorkBlock from "@components/home/WorkBlock.astro";
import LatestWritings from "@components/home/LatestWritings.astro";
import WealthLine from "@components/home/WealthLine.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const home = t(locale).home;
---

<BaseLayout
  locale={locale}
  title={home.meta.title}
  rawTitle
  description={home.meta.description}
  path="/"
  jsonLd={homeJsonLd(locale)}
>
  <HomeHero locale={locale} />
  <RunningList locale={locale} />
  <div class="wrap split home-split">
    <WorkBlock locale={locale} />
    <LatestWritings locale={locale} />
  </div>
  <WealthLine locale={locale} />
</BaseLayout>

<style>
  .home-split {
    margin-top: var(--section-gap);
    display: grid;
    row-gap: var(--section-gap);
  }
  @media (min-width: 1100px) {
    .home-split {
      row-gap: 0;
    }
  }
</style>
