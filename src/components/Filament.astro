---
/**
 * Scroll filament layer (spec 2.3). Rendered once per page by BaseLayout.
 *
 * Two co-located renderings share the seeded reference path:
 *  - `.fila-svg` : the static reference path (trunk + branch hyphae), generated
 *    at runtime by measuring the document. Fully drawn under no-JS and reduced
 *    motion (mockup D behaviour); faded to a guide under `html.anim`.
 *  - `.fila-canvas` : the living physarum overlay, driven by `mountFilament`.
 *
 * The layer is a non-interactive, aria-hidden margin decoration.
 */
---

<div class="fila" aria-hidden="true">
  <svg class="fila-svg" focusable="false" preserveAspectRatio="none" aria-hidden="true">
    <path class="trunk"></path>
    <g class="br"></g>
  </svg>
  <canvas class="fila-canvas"></canvas>
</div>

<style>
  /* Absolute margin layer; height 0 so it never inflates document flow. */
  .fila {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 0;
    z-index: 1;
    pointer-events: none;
  }

  /* Reference path, sized to the whole document by the mount script. */
  .fila-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    overflow: visible;
  }
  .fila-svg path {
    fill: none;
    stroke: var(--accent);
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .fila-svg .trunk {
    stroke-width: 1.4;
    opacity: 0.5;
  }
  .fila-svg :global(.br path) {
    stroke-width: 1;
    opacity: 0.42;
  }

  /* Living overlay: fixed viewport canvas, hidden until the sim runs. */
  .fila-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
  }

  /* When the sim is live, the SVG recedes to a faint guide and the canvas
     carries the motion. Gated by the `living` class the mount script adds
     only under `html.anim`. */
  .fila.living .fila-svg .trunk {
    opacity: 0.16;
  }
  .fila.living .fila-svg :global(.br path) {
    opacity: 0.14;
  }
  .fila.living .fila-canvas {
    opacity: 1;
  }
</style>

<script>
  import { mountFilament } from "@lib/filament";

  const root = document.querySelector<HTMLElement>(".fila");
  if (root) {
    const handle = mountFilament(root);
    document.addEventListener("astro:before-swap", () => handle.destroy(), {
      once: true,
    });
  }
</script>
