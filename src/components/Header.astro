---
import { type Locale, t, localePath, alternates } from "@i18n/index";

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const dict = t(locale);

const navItems = [
  { key: "projets", href: "/projets" },
  { key: "outils", href: "/outils" },
  { key: "ecrits", href: "/ecrits" },
] as const;

/** Active when the logical path is the section root or nested under it. */
const isActive = (href: string): boolean =>
  path === href || path.startsWith(`${href}/`);

const langHrefs = alternates(path);
const langLabel: Record<Locale, string> = { fr: "FR", en: "EN", es: "ES" };
---

<header class="site-head">
  <a
    class="wordmark"
    href={localePath(locale, "/")}
    aria-label={dict.nav.home}
    ><span class="br" aria-hidden="true">[</span><span class="lead">w</span
    ><span class="rest" aria-hidden="true"><i>m</i><i>m</i><i>w</i></span
    ><span class="br" aria-hidden="true">]</span></a
  >
  <nav class="site-nav" aria-label={dict.nav.ariaLabel}>
    {
      navItems.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={localePath(locale, item.href)}
            class:list={{ on: active }}
            aria-current={active ? "page" : undefined}
          >
            {dict.nav[item.key]}
          </a>
        );
      })
    }
  </nav>
  <nav class="lang" aria-label={dict.lang.label}>
    {
      langHrefs.map((alt, i) => (
        <>
          {i > 0 && <span class="dot" aria-hidden="true">·</span>}
          <a
            href={alt.href}
            hreflang={alt.locale}
            class:list={{ on: alt.locale === locale }}
            aria-current={alt.locale === locale ? "true" : undefined}
            aria-label={dict.lang.switchTo[alt.locale]}
            >{langLabel[alt.locale]}</a
          >
        </>
      ))
    }
  </nav>
</header>

<style>
  /* Always overlays the hero canvas, on every page: one consistent style. */
  .site-head {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: "mark nav lang";
    align-items: center;
    gap: 1rem 2rem;
    min-height: 4.25rem;
    padding: 1.1rem var(--pad);
  }
  /* Soft top scrim for legibility over bright sim regions. No hard bar. */
  .site-head::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: -2rem;
    background: linear-gradient(
      to bottom,
      rgba(18, 16, 13, 0.75),
      rgba(18, 16, 13, 0)
    );
    pointer-events: none;
    z-index: -1;
  }
  /* Membrane: frost the top strip so nav stays legible over bright sim
     regions without a hard bar. The gradient above is the fallback. */
  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .site-head::before {
      background: linear-gradient(
        to bottom,
        rgba(18, 16, 13, 0.55),
        rgba(18, 16, 13, 0)
      );
      -webkit-backdrop-filter: blur(9px) saturate(var(--glass-sat));
      backdrop-filter: blur(9px) saturate(var(--glass-sat));
      -webkit-mask-image: linear-gradient(to bottom, #000 45%, transparent 100%);
      mask-image: linear-gradient(to bottom, #000 45%, transparent 100%);
    }
  }

  .wordmark {
    grid-area: mark;
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    /* Reserve the full [wmmw] width so expanding the logo moves only its own
       letters, never the (centered) nav or the grid columns. */
    min-width: 6.2ch;
    font-family: var(--mono);
    font-weight: 700;
    font-size: 1.1rem;
    line-height: 1;
    letter-spacing: 0.01em;
    text-decoration: none;
    color: var(--bone);
    border-radius: 8px;
  }
  .wordmark .br {
    color: var(--accent);
  }
  .wordmark .rest {
    display: inline-flex;
    overflow: hidden;
  }
  .wordmark .rest i {
    font-style: normal;
    display: inline-block;
  }
  .wordmark:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* Always collapsed to [w] (asi0 review, 2026-09-04: "just [w]" on every
     device); expands to [wmmw] on hover/focus. */
  .wordmark .rest {
    max-width: 0;
  }
  .wordmark .rest i {
    opacity: 0;
  }
  .wordmark:hover .rest,
  .wordmark:focus-visible .rest {
    max-width: 3.2ch;
  }
  .wordmark:hover .rest i,
  .wordmark:focus-visible .rest i {
    opacity: 1;
  }

  .site-nav {
    grid-area: nav;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.2rem);
    font-size: 0.92rem;
    line-height: 1;
  }
  .site-nav a {
    color: var(--ink-2);
    text-decoration: none;
  }
  .site-nav a:hover,
  .site-nav a.on {
    color: var(--bone);
  }
  .site-nav a.on {
    font-weight: 500;
  }

  .lang {
    grid-area: lang;
    justify-self: end;
    align-items: center;
    /* mono, not disp: Basteleur's decorative capitals make EN/ES unreadable */
    font-family: var(--mono);
    font-size: 0.78rem;
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--ink-3);
    display: flex;
    gap: 0.45rem;
  }
  .lang a {
    color: var(--ink-3);
    text-decoration: none;
  }
  .lang a:hover {
    color: var(--bone);
  }
  .lang a.on {
    color: var(--accent);
  }
  .lang .dot {
    color: var(--ink-3);
  }

  :global(html.anim) .site-nav a,
  :global(html.anim) .lang a {
    transition: color 0.2s ease;
  }

  @media (max-width: 767px) {
    .site-head {
      grid-template-columns: auto auto;
      grid-template-areas:
        "mark lang"
        "nav  nav";
      row-gap: 0.8rem;
    }
    .site-nav {
      justify-content: flex-start;
      flex-wrap: wrap;
      gap: 1rem;
      font-size: 0.88rem;
    }
  }

  /* Motion only when the site has armed animation (respects reduced-motion).
     Each letter rotates in half a turn: a "w" flipping over into its mirror
     "m" (and back to "w" for the last glyph) as [w] grows into [wmmw]. */
  :global(html.anim) .wordmark .rest {
    transition: max-width 0.44s cubic-bezier(0.2, 0.85, 0.25, 1);
  }
  :global(html.anim) .wordmark .rest i {
    transform: translateX(-0.28em) rotate(180deg);
    transition:
      opacity 0.3s ease,
      transform 0.5s cubic-bezier(0.2, 0.85, 0.25, 1);
  }
  :global(html.anim) .wordmark:hover .rest i,
  :global(html.anim) .wordmark:focus-visible .rest i {
    transform: none;
  }
  :global(html.anim) .wordmark:hover .rest i:nth-child(1),
  :global(html.anim) .wordmark:focus-visible .rest i:nth-child(1) {
    transition-delay: 0.03s;
  }
  :global(html.anim) .wordmark:hover .rest i:nth-child(2),
  :global(html.anim) .wordmark:focus-visible .rest i:nth-child(2) {
    transition-delay: 0.09s;
  }
  :global(html.anim) .wordmark:hover .rest i:nth-child(3),
  :global(html.anim) .wordmark:focus-visible .rest i:nth-child(3) {
    transition-delay: 0.15s;
  }
</style>
