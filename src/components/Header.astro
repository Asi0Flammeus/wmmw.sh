---
import { type Locale, t, localePath, alternates } from "@i18n/index";

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const dict = t(locale);

const navItems = [
  { key: "projets", href: "/projets" },
  { key: "outils", href: "/outils" },
  { key: "ecrits", href: "/ecrits" },
  { key: "nourritures", href: "/nourritures" },
  { key: "manifeste", href: "/manifeste" },
] as const;

/** Active when the logical path is the section root or nested under it. */
const isActive = (href: string): boolean =>
  path === href || path.startsWith(`${href}/`);

const langHrefs = alternates(path);
const langLabel: Record<Locale, string> = { fr: "FR", en: "EN", es: "ES" };
---

<header class="site-head">
  <a
    class="wordmark"
    href={localePath(locale, "/")}
    aria-label={dict.nav.home}>wmmw.sh</a
  >
  <nav class="site-nav" aria-label={dict.nav.ariaLabel}>
    {
      navItems.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={localePath(locale, item.href)}
            class:list={{ on: active }}
            aria-current={active ? "page" : undefined}
          >
            {dict.nav[item.key]}
          </a>
        );
      })
    }
  </nav>
  <nav class="lang" aria-label={dict.lang.label}>
    {
      langHrefs.map((alt, i) => (
        <>
          {i > 0 && <span class="dot" aria-hidden="true">·</span>}
          <a
            href={alt.href}
            hreflang={alt.locale}
            class:list={{ on: alt.locale === locale }}
            aria-current={alt.locale === locale ? "true" : undefined}
            aria-label={dict.lang.switchTo[alt.locale]}
            >{langLabel[alt.locale]}</a
          >
        </>
      ))
    }
  </nav>
</header>

<style>
  /* Always overlays the hero canvas, on every page: one consistent style. */
  .site-head {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: "mark nav lang";
    align-items: center;
    gap: 1rem 2rem;
    min-height: 4.25rem;
    padding: 1.1rem var(--pad);
  }
  /* Soft top scrim for legibility over bright sim regions. No hard bar. */
  .site-head::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: -2rem;
    background: linear-gradient(
      to bottom,
      rgba(18, 16, 13, 0.75),
      rgba(18, 16, 13, 0)
    );
    pointer-events: none;
    z-index: -1;
  }

  .wordmark {
    grid-area: mark;
    font-family: var(--disp);
    font-weight: 500;
    font-size: 1.15rem;
    line-height: 1;
    letter-spacing: -0.02em;
    text-decoration: none;
    display: inline-block;
    color: var(--bone);
  }

  .site-nav {
    grid-area: nav;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.2rem);
    font-size: 0.92rem;
    line-height: 1;
  }
  .site-nav a {
    color: var(--ink-2);
    text-decoration: none;
  }
  .site-nav a:hover,
  .site-nav a.on {
    color: var(--bone);
  }
  .site-nav a.on {
    font-weight: 500;
  }

  .lang {
    grid-area: lang;
    justify-self: end;
    align-items: center;
    font-family: var(--disp);
    font-size: 0.78rem;
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--ink-3);
    display: flex;
    gap: 0.45rem;
  }
  .lang a {
    color: var(--ink-3);
    text-decoration: none;
  }
  .lang a:hover {
    color: var(--bone);
  }
  .lang a.on {
    color: var(--accent);
  }
  .lang .dot {
    color: var(--ink-3);
  }

  :global(html.anim) .site-nav a,
  :global(html.anim) .lang a {
    transition: color 0.2s ease;
  }

  @media (max-width: 767px) {
    .site-head {
      grid-template-columns: auto auto;
      grid-template-areas:
        "mark lang"
        "nav  nav";
      row-gap: 0.8rem;
    }
    .site-nav {
      justify-content: flex-start;
      flex-wrap: wrap;
      gap: 1rem;
      font-size: 0.88rem;
    }
  }
</style>
