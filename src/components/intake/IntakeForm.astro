---
/**
 * The intake card (spec §8.4, §8.5; copy deck §9). One form serves both modes:
 * with JS (intake.client.ts) one step at a time, without JS one long form whose
 * step 2 groups show through :has(). The server is the validator; no HTML
 * `required`. Step 4 is server-rendered (IntakeConfirmation).
 */
import { type Locale, t, localePath } from "@i18n/index";
import { LIMITS, type Brief, type Errors } from "@lib/intake/rules";
import { errorText, fieldId } from "@lib/intake/messages";
import { ALYSIS_URL, PLANB_URL } from "@lib/site";
import Button from "@components/ui/Button.astro";
import Arrow from "@components/ui/Arrow.astro";
import PathCards from "./PathCards.astro";
import ChipGroup from "./ChipGroup.astro";
import ChannelFields from "./ChannelFields.astro";
import Field from "./Field.astro";
import IntakeConfirmation from "./IntakeConfirmation.astro";
import "./intake.css";

interface Props {
  locale: Locale;
  /** signed start token for this render */
  started: string;
  minMs: number;
  /** logical page stored in the payload, e.g. "/contact?chemin=outil" */
  page: string;
  /** path preselected by ?chemin= (tool | open | other), or "site" for the alysis panel */
  chemin?: string;
  /** no-JS re-render after a failed POST */
  values?: Brief;
  errors?: Errors;
  /** no-JS: a missing, forged or stale token (form re-rendered with a fresh one) */
  invalidToken?: boolean;
  /** no-JS: accepted, show the confirmation instead of the form */
  accepted?: { ref: string; fit: string };
}

const { locale, started, minMs, page, chemin, values, errors = {}, invalidToken = false, accepted } = Astro.props;
const dict = t(locale);
const s = dict.intake;
const path = values?.path || (chemin && chemin !== "site" ? chemin : "");
const f = values?.fields ?? {};
const channel = values?.contact.channel ?? "";
const err = (key: string): string | undefined => {
  const code = errors[key];
  return code ? errorText(key, code, channel, s) : undefined;
};
const errorKeys = Object.keys(errors);
const contact = localePath(locale, "/contact");

/* strings the client needs (it never imports the dictionary) */
const i18n = JSON.stringify({ intake: s, paths: dict.paths }).replace(/</g, "\\u003c");
---

<div class="intake-card" id="intake" data-intake-card>
  {
    accepted && values ? (
      <IntakeConfirmation locale={locale} brief={values} accepted={accepted} />
    ) : (
      <Fragment>
        <script type="application/json" data-intake-i18n set:html={i18n} />
        <form
          class="intake"
          id="intake-form"
          data-qa="intake"
          method="post"
          action={`${contact}#intake`}
          novalidate
          data-astro-reload
          data-locale={locale}
          data-min-ms={minMs}
          data-chemin={chemin}
        >
          <div class="intake-head" data-js-only>
            <button type="button" class="intake-back" data-back hidden>
              <Arrow dir="left" />
              {s.back}
            </button>
            <p class="intake-progress" data-progress></p>
          </div>
          <p class="sr" aria-live="polite" data-live></p>

          <div class="err-summary" role="alert" tabindex="-1" data-err-summary hidden={!errorKeys.length && !invalidToken}>
            {invalidToken && <p>{s.net.invalid}</p>}
            {errorKeys.length > 0 && (
              <Fragment>
                <p>{errorKeys.length === 1 ? s.err.summary.one : s.err.summary.many.replace("{n}", String(errorKeys.length))}</p>
                <ul>
                  {errorKeys.map((key) => (
                    <li>
                      <a href={`#${fieldId(key, path, channel)}`} data-err-link={key}>
                        {err(key)}
                      </a>
                    </li>
                  ))}
                </ul>
              </Fragment>
            )}
          </div>

          <p class="recap" data-recap hidden>
            <span>
              {s.recap.path}
              {" "}
              <strong data-recap-path></strong>
            </span>
            <button type="button" class="text-btn" data-change>{s.change}</button>
          </p>

          {
            chemin === "site" && (
              <section class="site-panel" data-site-panel>
                <h2 class="q">{s.site.title}</h2>
                <p>{s.site.body}</p>
                <p class="site-actions">
                  <Button variant="secondary" href={ALYSIS_URL} external locale={locale}>
                    {s.site.go}
                  </Button>
                  <button type="button" class="text-btn" data-site-back data-js-only>
                    {s.site.back}
                  </button>
                </p>
              </section>
            )
          }

          <section class="step" data-step="1" data-qa="intake-step-1">
            <fieldset class="step-set">
              <legend>
                <h2 class="q" tabindex="-1">{s.s1.question}</h2>
              </legend>
              <PathCards locale={locale} value={path} error={err("path")} />
            </fieldset>
            <p class="learn">
              {s.s1.learn.lead}{" "}
              <a href={PLANB_URL} rel="noopener">{s.s1.learn.planb}</a>,{" "}
              <a href={localePath(locale, "/ecrits")}>{s.s1.learn.writings}</a>,{" "}
              <a href={localePath(locale, "/outils")}>{s.s1.learn.tools}</a>.
            </p>
            <div class="step-foot" data-js-only>
              <Button variant="secondary" arrow="right" locale={locale} class="continue" data-qa="intake-continue">
                {s.continue}
              </Button>
            </div>
          </section>

          <section class="step" data-step="2" data-qa="intake-step-2">
            <div class="group" data-path-group="tool">
              <h2 class="q" tabindex="-1">{s.tool.question}</h2>
              <ChipGroup legend={s.tool.team.legend} name="fields.team" idPrefix="tool-team" options={s.tool.team.options} value={f.team} error={err("fields.team")} />
              <Field id="tool-problem" name="fields.problem" label={s.tool.problem.label} hint={s.tool.problem.hint} ph={s.tool.problem.ph} multiline max={LIMITS.problem[1]} value={f.problem} error={err("fields.problem")} />
              <Field id="tool-solved" name="fields.solved" label={s.tool.solved.label} hint={s.tool.solved.hint} ph={s.tool.solved.ph} multiline max={LIMITS.solved[1]} value={f.solved} error={err("fields.solved")} />
              <Field id="tool-tools" name="fields.tools" label={s.tool.tools.label} hint={s.tool.tools.hint} ph={s.tool.tools.ph} max={LIMITS.tools[1]} value={f.tools} error={err("fields.tools")} />
              <ChipGroup legend={s.tool.when.legend} name="fields.when.tool" idPrefix="tool-when" options={s.when.options} value={path === "tool" ? f.when : undefined} error={path === "tool" ? err("fields.when") : undefined} />
              <ChipGroup legend={s.tool.budget.legend} name="fields.budget" idPrefix="tool-budget" options={s.tool.budget.options} aria={s.tool.budget.aria} hint={s.tool.budget.hint} value={f.budget} error={err("fields.budget")} />
            </div>
            <div class="group" data-path-group="open">
              <h2 class="q" tabindex="-1">{s.open.question}</h2>
              <Field id="open-link" name="fields.link" label={s.open.link.label} hint={s.open.link.hint} ph={s.open.link.ph} type="url" inputmode="url" max={LIMITS.link[1]} value={f.link} error={err("fields.link")} />
              <Field id="open-bring" name="fields.bring" label={s.open.bring.label} hint={s.open.bring.hint} ph={s.open.bring.ph} multiline max={LIMITS.bring[1]} value={f.bring} error={err("fields.bring")} />
              <Field id="open-need" name="fields.need" label={s.open.need.label} hint={s.open.need.hint} ph={s.open.need.ph} multiline max={LIMITS.need[1]} value={f.need} error={err("fields.need")} />
              <Field id="open-why" name="fields.why" label={s.open.why.label} hint={s.open.why.hint} ph={s.open.why.ph} multiline max={LIMITS.why[1]} value={f.why} error={err("fields.why")} />
              <ChipGroup legend={s.open.funding.legend} name="fields.funding" idPrefix="open-funding" options={s.open.funding.options} value={f.funding} error={err("fields.funding")} />
              <ChipGroup legend={s.open.when.legend} name="fields.when.open" idPrefix="open-when" options={s.when.options} value={path === "open" ? f.when : undefined} error={path === "open" ? err("fields.when") : undefined} />
            </div>
            <div class="group" data-path-group="other">
              <h2 class="q" tabindex="-1">{s.other.question}</h2>
              <ChipGroup legend={s.other.topic.legend} name="fields.topic" idPrefix="other-topic" options={s.other.topic.options} value={f.topic} error={err("fields.topic")} />
              <Field id="other-message" name="fields.message" label={s.other.msg.label} hint={f.topic === "data" ? s.other.msg.hintData : s.other.msg.hint} ph={s.other.msg.ph} multiline max={LIMITS.message[1]} value={f.message} error={err("fields.message")} />
            </div>
            <p class="safe">{s.s2.safe}</p>
            <div class="step-foot" data-js-only>
              <Button variant="secondary" arrow="right" locale={locale} class="continue" data-qa="intake-continue">
                {s.continue}
              </Button>
            </div>
          </section>

          <section class="step" data-step="3" data-qa="intake-step-3">
            <h2 class="q" tabindex="-1">{s.s3.question}</h2>
            <Field id="contact-name" name="contact.name" label={s.s3.name.label} ph={s.s3.name.ph} autocomplete="given-name" max={LIMITS.name[1]} value={values?.contact.name} error={err("contact.name")} />
            <ChannelFields locale={locale} channel={channel} value={values?.contact.value} channelError={err("contact.channel")} valueError={err("contact.value")} />
            <p class="no-list">{s.s3.noList}</p>
            <div class="consent" data-field="consent">
              <label class="consent-box">
                <input type="checkbox" name="consent" id="consent" checked={values?.consent} aria-describedby="consent-err" aria-invalid={errors.consent ? "true" : undefined} />
                <span>{s.s3.consent}</span>
              </label>
              <a class="consent-link" href={`${localePath(locale, "/mentions-legales")}#donnees`}>{s.s3.consentLink}</a>
              <p class="field-err" id="consent-err" hidden={!errors.consent}>
                <svg class="err-glyph" viewBox="0 0 14 14" aria-hidden="true"><circle cx="7" cy="7" r="6" /><path d="M7 3.8v3.9M7 9.9v.3" /></svg>
                <span data-err-text>{err("consent")}</span>
              </p>
            </div>
            <div class="send">
              <p class="status" role="status" aria-live="polite" data-status></p>
              <button type="button" class="text-btn" data-retry hidden>{s.net.retry}</button>
              <Button variant="primary" type="submit" locale={locale} data-qa="intake-send">
                {s.s3.send}
              </Button>
            </div>
          </section>

          <input type="hidden" name="locale" value={locale} />
          <input type="hidden" name="started" value={started} />
          <input type="hidden" name="page" value={page} />
          <input type="hidden" name="from" value="" />
          <div class="trap" aria-hidden="true">
            <label for="site_web">{s.honeypot}</label>
            <input id="site_web" type="text" name="site_web" tabindex="-1" autocomplete="off" />
          </div>
        </form>
        <IntakeConfirmation locale={locale} />
      </Fragment>
    )
  }
</div>

<script>
  import { initIntake } from "./intake.client";

  let ac: AbortController | undefined;
  document.addEventListener("astro:page-load", () => {
    ac?.abort();
    const form = document.querySelector<HTMLFormElement>("#intake-form");
    if (!form) return;
    ac = new AbortController();
    initIntake(form, ac.signal);
  });
  document.addEventListener("astro:before-swap", () => ac?.abort());
</script>
