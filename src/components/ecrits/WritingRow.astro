---
/** One writing in the /ecrits list (spec §7.4): ISO date, title, description; the whole row is the link. */
import { type Locale, localePath, isoDate } from "@i18n/index";
import { baseSlug, type Writing } from "@lib/writings";

interface Props {
  locale: Locale;
  entry: Writing;
}

const { locale, entry } = Astro.props;
const { data } = entry;
---

<li class="wrow">
  <a class="wrow-link" href={localePath(locale, `/ecrits/${baseSlug(entry)}`)}>
    <time class="wrow-date" datetime={isoDate(data.publishedAt)}>{isoDate(data.publishedAt)}</time>
    <span class="wrow-title">{data.title}</span>
    <span class="wrow-desc">{data.description}</span>
  </a>
</li>

<style>
  .wrow {
    border-top: 1px solid var(--line);
  }
  .wrow:last-child {
    border-bottom: 1px solid var(--line);
  }
  .wrow-link {
    display: grid;
    gap: 0.3rem;
    padding-block: 1.1rem;
    color: inherit;
    text-decoration: none;
  }
  .wrow-link:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
    border-radius: var(--r-1);
  }
  .wrow-date {
    font-family: var(--mono);
    font-size: var(--fs-meta);
    line-height: var(--lh-mono);
    letter-spacing: var(--ls-mono);
    font-variant-numeric: tabular-nums;
    color: var(--ink-3);
  }
  .wrow-title {
    font-family: var(--disp);
    font-feature-settings: "ss01";
    font-size: var(--fs-h3);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-disp);
    color: var(--ink);
    text-wrap: balance;
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
  .wrow-link:is(:hover, :focus-visible) .wrow-title {
    text-decoration-color: currentColor;
  }
  .wrow-desc {
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--ink-2);
    text-wrap: pretty;
  }
</style>
