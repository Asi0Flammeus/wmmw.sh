---
import { type Locale, t, localePath } from "@i18n/index";
import { GITHUB_URL } from "@lib/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);

const rssHref = localePath(locale, "/rss.xml");
---

<footer class="site-foot">
  <div class="wrap">
    <div class="foot-inner">
      <p class="foot-mark" aria-hidden="true">w·m·m·w</p>
      <p class="foot-thesis">{dict.footer.thesis}</p>
      <nav class="foot-links">
        <a href={GITHUB_URL} rel="me">GitHub</a>
        <a href={rssHref}>{dict.footer.rss}</a>
        <a href={localePath(locale, "/contact")}>{dict.footer.contact}</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-foot {
    position: relative;
    z-index: 2;
    margin-top: clamp(4rem, 11vh, 8rem);
    border-top: 1px solid var(--hair-2);
  }
  .foot-inner {
    padding-block: clamp(2.5rem, 6vh, 4rem);
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }
  .foot-mark {
    font-family: var(--mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.35em;
    color: var(--accent);
  }
  .foot-thesis {
    max-width: 52ch;
    color: var(--ink-2);
    font-size: var(--fs-small);
    text-wrap: pretty;
  }
  .foot-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 1.6rem;
  }
  .foot-links a {
    color: var(--bone);
    font-size: var(--fs-small);
    text-decoration: none;
    border-bottom: 1px solid var(--hair);
    padding-bottom: 0.1em;
  }
  .foot-links a:hover,
  .foot-links a:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
  }
  :global(html.anim) .foot-links a {
    transition:
      color var(--t-base) ease,
      border-color var(--t-base) ease;
  }
</style>
