---
/**
 * V2 « Cinq fils » (copy deck §3.5): five woven strands, the fourth (money)
 * drawn bolder in ink, by contrast and weight, never by hue. Path data is
 * computed here at build: no client JS. M5: on hover or focus of the nearest
 * [data-strands-host], the strands spread from 6 to 9 px apart (400 ms) and
 * weave back on leave. Static with reduced motion and on touch.
 */
interface Props {
  /** figure: 120 x 40 (home); stub: 16 x 8 bullet (/contact). */
  variant?: "figure" | "stub";
  /** stub only; 3 is the money strand (bold ink). */
  strand?: 0 | 1 | 2 | 3 | 4;
  /** figure only: role="img" + aria-label; absent => aria-hidden. */
  label?: string;
  class?: string;
}

const { variant = "figure", strand = 0, label, class: className } = Astro.props;
const MONEY = 3;

/** One strand as a smooth sampled sine, `periods` across `w`, centred on y0. */
const wave = (w: number, y0: number, amp: number, phase: number, periods: number): string => {
  const steps = Math.max(8, Math.round(w / 2));
  let d = "";
  for (let i = 0; i <= steps; i++) {
    const x = (w * i) / steps;
    const y = y0 + amp * Math.sin((2 * Math.PI * periods * i) / steps + phase);
    d += `${i === 0 ? "M" : "L"}${x.toFixed(2)} ${y.toFixed(2)}`;
  }
  return d;
};

const figure = variant === "figure";
const width = figure ? 120 : 16;
const height = figure ? 40 : 8;
/* neighbours run in opposite phase, so each pair meets twice across the figure: a loose weave */
const strands = figure
  ? [0, 1, 2, 3, 4].map((i) => ({ i, d: wave(120, 8 + i * 6, 3, (i % 2) * Math.PI + i * 0.35, 1.5) }))
  : [{ i: strand, d: wave(16, 4, 2, (strand % 2) * Math.PI, 1) }];
const named = figure && label;
---

<svg
  class:list={["five-strands", `strands-${variant}`, className]}
  viewBox={`0 0 ${width} ${height}`}
  width={width}
  height={height}
  fill="none"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={named ? "img" : undefined}
  aria-label={named ? label : undefined}
  aria-hidden={named ? undefined : "true"}
  focusable="false"
  data-qa="visual-v2"
>
  {
    strands.map((s) => (
      <path
        class:list={["strand", { money: s.i === MONEY }]}
        data-strand={s.i}
        style={figure ? `--spread:${(s.i - 2) * 3}px` : undefined}
        d={s.d}
      />
    ))
  }
</svg>

<style>
  .five-strands {
    display: block;
    flex: none;
    overflow: visible;
  }
  .strand {
    stroke: var(--ink-3);
    stroke-width: 1.25;
  }
  .strand.money {
    stroke: var(--ink);
    stroke-width: 1.75;
  }
  @media (hover: hover) and (pointer: fine) {
    :global(html.anim) .strands-figure .strand {
      transition: transform 400ms var(--ease-out);
    }
    :global(html.anim [data-strands-host]:hover) .strands-figure .strand,
    :global(html.anim [data-strands-host]:focus-visible) .strands-figure .strand {
      transform: translateY(var(--spread));
    }
  }
  @media (forced-colors: active) {
    .strand {
      stroke: CanvasText;
    }
  }
</style>
