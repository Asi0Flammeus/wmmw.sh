---
/**
 * Full periodic table with category-based coloring.
 * Carbon (6) and Silicon (14) are highlighted as the article's protagonists.
 */

interface Props {
  highlightElements?: number[];
}

const { highlightElements = [6, 14] } = Astro.props;

type Category =
  | 'alkali'
  | 'alkaline'
  | 'transition'
  | 'post-transition'
  | 'metalloid'
  | 'nonmetal'
  | 'halogen'
  | 'noble'
  | 'lanthanide'
  | 'actinide'
  | 'unknown';

interface Element {
  z: number;
  symbol: string;
  name: string;
  cat: Category;
  row: number;
  col: number;
}

// Full periodic table data: [z, symbol, name, category, row, col]
const elements: Element[] = [
  // Period 1
  { z: 1,   symbol: 'H',  name: 'Hydrogen',      cat: 'nonmetal',         row: 1, col: 1 },
  { z: 2,   symbol: 'He', name: 'Helium',         cat: 'noble',            row: 1, col: 18 },
