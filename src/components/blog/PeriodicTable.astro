const highlightSet = new Set(highlightElements);
---

<figure class="ptable-wrap" role="img" aria-label="Periodic Table of Elements">
  <div class="ptable-scroll">
    <div class="ptable">
      {elements.map((el) => (
        <div
          class:list={[
            'ptable-el',
            `ptable-cat--${el.cat}`,
            highlightSet.has(el.z) && 'ptable-el--highlight',
          ]}
          style={`grid-row: ${el.row}; grid-column: ${el.col};`}
          title={`${el.z} — ${el.name}`}
        >
          <span class="ptable-z">{el.z}</span>
          <span class="ptable-sym">{el.symbol}</span>
          <span class="ptable-name">{el.name}</span>
        </div>
      ))}

      {/* Lanthanide/Actinide indicator arrows */}
      <div class="ptable-label" style="grid-row: 6; grid-column: 3;">
        <span class="ptable-label-range">57-71 ▼</span>
      </div>
      <div class="ptable-label" style="grid-row: 7; grid-column: 3;">
        <span class="ptable-label-range">89-103 ▼</span>
      </div>
    </div>
  </div>

  <div class="ptable-legend">
    <span class="ptable-legend-item ptable-cat--alkali">Alkali</span>
    <span class="ptable-legend-item ptable-cat--alkaline">Alkaline</span>
    <span class="ptable-legend-item ptable-cat--transition">Transition</span>
    <span class="ptable-legend-item ptable-cat--post-transition">Post-trans.</span>
    <span class="ptable-legend-item ptable-cat--metalloid">Metalloid</span>
    <span class="ptable-legend-item ptable-cat--nonmetal">Nonmetal</span>
    <span class="ptable-legend-item ptable-cat--halogen">Halogen</span>
    <span class="ptable-legend-item ptable-cat--noble">Noble gas</span>
    <span class="ptable-legend-item ptable-cat--lanthanide">Lanthanide</span>
    <span class="ptable-legend-item ptable-cat--actinide">Actinide</span>
  </div>
</figure>

<style>
  .ptable-wrap {
    margin-block: var(--space-8);
  }

  .ptable-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding-bottom: var(--space-2);
    max-width: 100%;
  }

  .ptable {
    display: grid;
    grid-template-columns: repeat(18, 1fr);
    grid-template-rows: repeat(7, auto) var(--space-6) auto auto;
    gap: 2px;
    min-width: 720px;
    font-family: var(--font-sans);
  }

  /* --- Element tile --- */
  .ptable-el {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    min-width: 0;
    padding: 2px;
    border-radius: 3px;
    border: 1px solid var(--border-subtle);
    cursor: default;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    position: relative;
  }

  .ptable-el:hover {
    transform: scale(1.3);
    z-index: 10;
    box-shadow: 0 4px 16px color-mix(in srgb, var(--black) 30%, transparent);
  }

  /* --- Atomic number --- */
  .ptable-z {
    font-size: clamp(0.4rem, 0.7vw, 0.6rem);
    line-height: 1;
    opacity: 0.7;
    position: absolute;
    top: 2px;
    left: 3px;
  }

  /* --- Symbol --- */
  .ptable-sym {
    font-size: clamp(0.7rem, 1.5vw, 1.1rem);
    font-weight: var(--font-semibold, 600);
    line-height: 1.1;
  }

  /* --- Name --- */
  .ptable-name {
    font-size: clamp(0.3rem, 0.55vw, 0.48rem);
    line-height: 1;
    opacity: 0.7;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 100%;
  }

  /* --- Highlight (Carbon & Silicon) --- */
  .ptable-el--highlight {
    border-width: 2px;
    box-shadow: 0 0 8px color-mix(in srgb, var(--orange-400) 30%, transparent);
    border-color: var(--orange-400) !important;
    z-index: 5;
  }

  .ptable-el--highlight .ptable-sym {
    color: var(--orange-400);
    font-weight: var(--font-bold, 700);
  }

  /* ===== Category colors ===== */

  /* Alkali metals — red */
  .ptable-cat--alkali {
    background: color-mix(in oklab, var(--red-400) 22%, transparent);
    border-color: color-mix(in srgb, var(--red-400) 30%, var(--border-subtle));
    color: var(--red-400);
  }
  .ptable-cat--alkali .ptable-sym { color: var(--red-400); }

  /* Alkaline earth — orange */
  .ptable-cat--alkaline {
    background: color-mix(in oklab, var(--orange-400) 20%, transparent);
    border-color: color-mix(in srgb, var(--orange-400) 25%, var(--border-subtle));
    color: var(--orange-400);
  }
  .ptable-cat--alkaline .ptable-sym { color: var(--orange-600); }

  /* Transition metals — blue */
  .ptable-cat--transition {
    background: color-mix(in oklab, var(--blue-400) 18%, transparent);
    border-color: color-mix(in srgb, var(--blue-400) 20%, var(--border-subtle));
    color: var(--blue-400);
  }
  .ptable-cat--transition .ptable-sym { color: var(--blue-400); }

  /* Post-transition metals — purple */
  .ptable-cat--post-transition {
    background: color-mix(in oklab, var(--purple-400) 20%, transparent);
    border-color: color-mix(in srgb, var(--purple-400) 22%, var(--border-subtle));
    color: var(--purple-400);
  }
  .ptable-cat--post-transition .ptable-sym { color: var(--purple-400); }

  /* Metalloids — cyan */
  .ptable-cat--metalloid {
    background: color-mix(in oklab, var(--cyan-400) 20%, transparent);
    border-color: color-mix(in srgb, var(--cyan-400) 25%, var(--border-subtle));
    color: var(--cyan-400);
  }
  .ptable-cat--metalloid .ptable-sym { color: var(--cyan-400); }

  /* Reactive nonmetals — yellow */
  .ptable-cat--nonmetal {
    background: color-mix(in oklab, var(--yellow-400) 20%, transparent);
    border-color: color-mix(in srgb, var(--yellow-400) 22%, var(--border-subtle));
    color: var(--yellow-400);
  }
  .ptable-cat--nonmetal .ptable-sym { color: var(--yellow-400); }

  /* Halogens — green */
  .ptable-cat--halogen {
    background: color-mix(in oklab, var(--green-400) 20%, transparent);
    border-color: color-mix(in srgb, var(--green-400) 25%, var(--border-subtle));
    color: var(--green-400);
  }
  .ptable-cat--halogen .ptable-sym { color: var(--green-400); }

  /* Noble gases — magenta */
  .ptable-cat--noble {
    background: color-mix(in oklab, var(--magenta-400) 20%, transparent);
    border-color: color-mix(in srgb, var(--magenta-400) 22%, var(--border-subtle));
    color: var(--magenta-400);
  }
  .ptable-cat--noble .ptable-sym { color: var(--magenta-400); }

  /* Lanthanides — softer red/pink */
  .ptable-cat--lanthanide {
    background: color-mix(in oklab, var(--red-400) 14%, transparent);
    border-color: color-mix(in srgb, var(--red-400) 15%, var(--border-subtle));
    color: var(--red-400);
  }
  .ptable-cat--lanthanide .ptable-sym { color: color-mix(in srgb, var(--red-400) 70%, var(--text-primary)); }

  /* Actinides — softer orange/peach */
  .ptable-cat--actinide {
    background: color-mix(in oklab, var(--orange-400) 14%, transparent);
    border-color: color-mix(in srgb, var(--orange-400) 15%, var(--border-subtle));
    color: var(--orange-400);
  }
  .ptable-cat--actinide .ptable-sym { color: color-mix(in srgb, var(--orange-400) 70%, var(--text-primary)); }

  /* --- Ln/Ac label placeholder --- */
  .ptable-label {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
  }

  .ptable-label-range {
    font-size: clamp(0.4rem, 0.6vw, 0.55rem);
    color: var(--text-tertiary);
    text-align: center;
    line-height: 1.2;
  }

  /* --- Legend --- */
  .ptable-legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: center;
    margin-top: var(--space-4);
    font-size: var(--text-xs);
    font-family: var(--font-sans);
  }

  .ptable-legend-item {
    padding: 2px 8px;
    border-radius: 3px;
    border: 1px solid;
  }

  /* Light theme adjustments */
  :global([data-theme='light']) .ptable-cat--alkali .ptable-sym { color: var(--red-600); }
  :global([data-theme='light']) .ptable-cat--alkaline .ptable-sym { color: var(--orange-600); }
  :global([data-theme='light']) .ptable-cat--transition .ptable-sym { color: var(--blue-600); }
  :global([data-theme='light']) .ptable-cat--post-transition .ptable-sym { color: var(--purple-600); }
  :global([data-theme='light']) .ptable-cat--metalloid .ptable-sym { color: var(--cyan-600); }
  :global([data-theme='light']) .ptable-cat--nonmetal .ptable-sym { color: var(--yellow-600); }
  :global([data-theme='light']) .ptable-cat--halogen .ptable-sym { color: var(--green-600); }
  :global([data-theme='light']) .ptable-cat--noble .ptable-sym { color: var(--magenta-600); }

  @media (prefers-reduced-motion: reduce) {
    .ptable-el {
      transition: none;
    }
  }

  @media (max-width: 768px) {
    .ptable {
      transform: scale(0.5);
      transform-origin: top left;
      width: 200%;
    }
  }
</style>
