---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

/**
 * Vertical timeline for a writings post. Copy lives in the MDX (props).
 * Rendered inside `.prose.crqpt-compat`, so it inherits the compat tokens.
 * `when` and `desc` accept inline HTML (e.g. <code>) — authored, trusted.
 * Each step may carry an optional image banner (an imported ImageMetadata);
 * absent, the card degrades to a clean text-only step.
 */
interface TimelineItem {
  n: string | number;
  when: string;
  title: string;
  desc: string;
  tone?: "muted" | "warn" | "accent";
  image?: ImageMetadata;
  imageAlt?: string;
}

interface Props {
  items: TimelineItem[];
}

const { items } = Astro.props;
---

<figure class="tl">
  <ol class="tl-list">
    {
      items.map((it) => (
        <li class={`tl-item tone-${it.tone ?? "muted"}`}>
          <div class="tl-rail" aria-hidden="true">
            <span class="tl-dot">{it.n}</span>
          </div>
          <div class="tl-card">
            {it.image && (
              <div class="tl-media">
                <Image
                  src={it.image}
                  alt={it.imageAlt ?? it.title}
                  widths={[400, 720, 1080]}
                  sizes="(max-width: 640px) 92vw, 680px"
                  loading="lazy"
                />
              </div>
            )}
            <div class="tl-body">
              <span class="tl-when" set:html={it.when} />
              <span class="tl-title">{it.title}</span>
              <p class="tl-desc" set:html={it.desc} />
            </div>
          </div>
        </li>
      ))
    }
  </ol>
  {
    Astro.slots.has("caption") && (
      <figcaption>
        <slot name="caption" />
      </figcaption>
    )
  }
</figure>

<style>
  .tl {
    margin-block: var(--space-8);
  }

  .tl-list {
    --tl-rail: 2.75rem;
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  /* Continuous spine linking the numbered dots, warming through the tones. */
  .tl-list::before {
    content: "";
    position: absolute;
    left: calc(var(--tl-rail) / 2);
    top: 1rem;
    bottom: 1rem;
    width: 2px;
    transform: translateX(-50%);
    background: linear-gradient(
      to bottom,
      var(--text-tertiary),
      var(--yellow-400),
      var(--green-400)
    );
    opacity: 0.4;
  }

  .tl-item {
    position: relative;
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .tl-rail {
    flex: none;
    width: var(--tl-rail);
    display: flex;
    justify-content: center;
    padding-top: 0.15rem;
  }

  .tl-dot {
    position: relative;
    z-index: 1;
    width: 2rem;
    height: 2rem;
    border-radius: var(--r-pill, 999px);
    display: grid;
    place-items: center;
    font-family: var(--mono);
    font-weight: var(--font-semibold, 600);
    font-size: 0.9rem;
    color: var(--black, #000);
    /* Ring punches the dot out of the running spine. */
    box-shadow: 0 0 0 4px var(--bg-primary);
  }
  .tone-muted .tl-dot {
    background: var(--text-tertiary);
  }
  .tone-warn .tl-dot {
    background: var(--yellow-400);
  }
  .tone-accent .tl-dot {
    background: var(--green-400);
  }

  .tl-card {
    flex: 1 1 auto;
    min-width: 0;
    background: color-mix(in oklab, var(--bg-secondary) 70%, transparent);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md, 8px);
    overflow: hidden;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }
  .tl-item:hover .tl-card {
    border-color: var(--text-tertiary);
  }
  .tone-muted .tl-card {
    border-top: 2px solid var(--text-tertiary);
  }
  .tone-warn .tl-card {
    border-top: 2px solid var(--yellow-400);
  }
  .tone-accent .tl-card {
    border-top: 2px solid var(--green-400);
  }

  .tl-media {
    aspect-ratio: 16 / 9;
    background: var(--bg-primary);
    border-bottom: 1px solid var(--border-subtle);
  }
  .tl-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tl-body {
    display: flex;
    flex-direction: column;
    padding: var(--space-4);
  }

  .tl-when {
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    letter-spacing: 0.03em;
  }
  .tl-title {
    font-family: var(--disp);
    font-weight: var(--font-semibold, 600);
    font-size: 1.15rem;
    color: var(--text-primary);
    margin-top: 0.15rem;
  }
  .tl-desc {
    margin: 0.4rem 0 0;
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .tl figcaption {
    margin-top: var(--space-6);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    font-style: italic;
    text-align: center;
  }

  @media (max-width: 640px) {
    .tl-list {
      --tl-rail: 2rem;
      gap: var(--space-4);
    }
    .tl-dot {
      width: 1.6rem;
      height: 1.6rem;
      font-size: 0.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tl-card {
      transition: none;
    }
  }
</style>
