---
/**
 * 404 (spec §7.9, copy deck §12): a single FR route that speaks all three
 * languages, FR first; an inline script moves EN or ES first when the
 * requested path starts with /en/ or /es/. The path is shown with textContent.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import Arrow from "@components/ui/Arrow.astro";
import { LOCALES, t, localePath } from "@i18n/index";

const fr = t("fr").notFound;
const blocks = LOCALES.map((l) => ({ locale: l, ...t(l).notFound, href: localePath(l, "/") }));
---

<BaseLayout locale="fr" title={fr.meta.title} rawTitle description={fr.line} path="/404" alternatesFor={["fr"]} noindex>
  <div class="wrap nf">
    <h1 class="sr">{fr.title}</h1>
    <p class="nf-path"><span id="nf-path">404</span></p>
    <div class="nf-blocks" id="nf-blocks">
      {
        blocks.map((b) => (
          <div class="nf-block" lang={b.locale} data-locale={b.locale}>
            <p class="nf-line">{b.line}</p>
            <a class="nf-home" href={b.href}>
              {b.home}
              <Arrow dir="right" />
            </a>
          </div>
        ))
      }
    </div>
  </div>
</BaseLayout>

<script is:inline>
  /* The pathname is attacker-influenced: textContent only, never innerHTML. */
  (function () {
    var p = window.location.pathname;
    var el = document.getElementById("nf-path");
    if (el) el.textContent = p;
    var m = /^\/(en|es)(\/|$)/.exec(p);
    var box = document.getElementById("nf-blocks");
    var first = m && box && box.querySelector('[data-locale="' + m[1] + '"]');
    if (first && box) box.insertBefore(first, box.firstChild);
  })();
</script>

<style>
  .nf {
    padding-top: clamp(2rem, 8svh, 5rem);
  }
  .nf-path {
    margin: 0;
    font-family: var(--mono);
    font-size: var(--fs-mono);
    letter-spacing: var(--ls-mono);
    color: var(--ink-3);
    overflow-wrap: anywhere;
  }
  .nf-blocks {
    display: grid;
    gap: var(--block-gap);
    margin-top: var(--block-gap);
  }
  .nf-line {
    margin: 0;
    max-width: 30ch;
    font-family: var(--disp);
    font-feature-settings: "ss01";
    font-size: var(--fs-h3);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-disp);
    color: var(--ink);
    text-wrap: balance;
  }
  .nf-home {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: var(--tap);
  }
</style>
