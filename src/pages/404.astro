---
import BaseLayout from "@layouts/BaseLayout.astro";
import { t } from "@i18n/index";

/* Astro emits a single /404.html; chrome is FR only, no [lang] variants. */
const locale = "fr" as const;
const dict = t(locale);
---

<BaseLayout
  locale={locale}
  title="404"
  description={dict.meta.notFound}
  path="/404"
>
  <section class="sec offset-l" data-block>
    <div class="wrap">
      <div class="sec-inner">
        <p class="nf-path meta-label reveal"><span id="nf-path">404</span></p>
        <p class="nf-out reveal">{dict.notFound.output}</p>
        <p class="nf-hint reveal">
          <a class="arrow-link" href="/">{dict.notFound.hint}</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  /* Fill the requested path client-side. textContent only: the pathname is
     attacker-influenced, so never assign it via innerHTML. */
  (function () {
    var el = document.getElementById("nf-path");
    if (el) el.textContent = window.location.pathname;
  })();
</script>

<style>
  .nf-path {
    overflow-wrap: anywhere;
  }
  .nf-out {
    margin-top: 1rem;
    font-family: var(--disp);
    font-weight: 500;
    font-size: var(--fs-h3);
    color: var(--bone);
    max-width: 30ch;
    text-wrap: balance;
  }
  .nf-hint {
    margin-top: 2rem;
  }
</style>
