---
/**
 * /lego (spec §10 WP1b): every brick of the registry rendered for real, each
 * block labelled with its registry id. Unlisted, noindex, out of the sitemap.
 * The legacy terminal panel lives here only, with its own typing call.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHead from "@components/ui/PageHead.astro";
import Arrow from "@components/ui/Arrow.astro";
import Button from "@components/ui/Button.astro";
import Chip from "@components/ui/Chip.astro";
import ThemeToggle from "@components/ThemeToggle.astro";
import Monogram from "@components/Monogram.astro";
import StepsLine from "@components/visual/StepsLine.astro";
import FiveStrands from "@components/visual/FiveStrands.astro";
import GhostsLens from "@components/moire/GhostsLens.astro";
import GhostsNotify from "@components/intake/GhostsNotify.astro";
import CopyLine from "@components/outils/CopyLine.astro";
import TerminalPanel from "@components/TerminalPanel.astro";
import TermCmd from "@components/TermCmd.astro";
import Timeline from "@components/blog/Timeline.astro";
import Poll from "@components/blog/Poll.astro";
import Math from "@components/blog/Math.astro";
import ZenCountdown from "@components/blog/ZenCountdown.astro";
import PeriodicColumn from "@components/blog/PeriodicColumn.astro";
import "@styles/crqpt-compat.css";

const locale = "fr" as const;
const SWATCHES = ["bg", "surface", "surface-2", "ink", "ink-2", "ink-3", "accent", "accent-text", "line-strong", "success", "fringe"];
---

<BaseLayout locale={locale} title="Lego" description="Galerie des composants du registre wmmw." path="/lego" alternatesFor={["fr"]} noindex>
  <div class="wrap lego">
    <PageHead title="Le lego" lead="Chaque brique du site, rendue en vrai. Annote ce qui cloche (Alt+Y)." />

    <section class="demo">
      <p class="demo-id">wmmw/tokens</p>
      <div class="islands">
        {
          ["light", "dark"].map((theme) => (
            <div class="island" data-theme={theme}>
              <ul class="swatches">
                {SWATCHES.map((name) => (
                  <li>
                    <span class="chip" style={`background: var(--${name})`} />
                    <code>--{name}</code>
                  </li>
                ))}
              </ul>
              <p class="spec-disp">Basteleur, le nom et les titres.</p>
              <p class="spec-body">Schibsted Grotesk porte la lecture, avec une vraie italique et des chiffres sobres.</p>
              <p class="spec-mono">JetBrains Mono : dates, repères, code. 2026-10-27</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="demo">
      <p class="demo-id">wmmw/editorial-css</p>
      <div class="prose">
        <h2>Un titre de prose</h2>
        <p>Un paragraphe de lecture avec <a href="/lego">un lien souligné</a>, du <code>code en ligne</code> et une <em>italique</em>.</p>
        <blockquote>La forêt n’a pas besoin d’un arbre de plus. Elle a besoin de mycélium.</blockquote>
      </div>
    </section>

    <section class="demo">
      <p class="demo-id">wmmw/ui-primitives</p>
      <div class="row-demo">
        <Button variant="primary" arrow="right" locale={locale}>La loupe (primaire)</Button>
        <Button variant="secondary" locale={locale}>Secondaire</Button>
        <Button variant="text" href="/lego" locale={locale}>Lien texte</Button>
      </div>
      <div class="row-demo">
        <Chip href="/lego" locale={locale}>Une puce</Chip>
        <Chip href="https://alysis.cat" locale={locale} external>Une puce externe</Chip>
        <span><Arrow dir="right" /> <Arrow dir="left" /> <Arrow dir="external" /> <Arrow dir="down" /></span>
      </div>
      <div class="row-demo">
        <label class="chip-radio"><input class="sr" type="radio" name="lego-chip" checked /><span>Choisi</span></label>
        <label class="chip-radio"><input class="sr" type="radio" name="lego-chip" /><span>Pas choisi</span></label>
        <span data-tip="Une info-bulle, 350 ms après le survol" tabindex="0">Survole-moi</span>
      </div>
      <CopyLine code="cargo install --git https://github.com/Asi0Flammeus/lazyagent" locale={locale} copyLabel="Copier" copiedLabel="Copié" />
    </section>

    <section class="demo">
      <p class="demo-id">wmmw/theme-toggle</p>
      <ThemeToggle locale={locale} />
    </section>

    <section class="demo">
      <p class="demo-id">wmmw/monogram</p>
      <div class="row-demo">
        <Monogram variant="line" size={256} label="Monogramme W·M en lignes" />
        <Monogram variant="line" size={256} mirrored tint />
        <Monogram variant="solid" size={48} />
        <Monogram variant="solid" size={32} />
        <Monogram variant="solid" size={16} />
      </div>
    </section>

    <section class="demo" data-steps-host>
      <p class="demo-id">wmmw/steps-line</p>
      <StepsLine locale={locale} variant="compact" />
      <div class="spaced"><StepsLine locale={locale} variant="detailed" /></div>
      <div class="spaced"><StepsLine locale={locale} variant="compact" done={1} /></div>
    </section>

    <section class="demo">
      <p class="demo-id">wmmw/five-strands</p>
      <a class="strands-demo" href="/lego" data-strands-host>
        <FiveStrands variant="figure" label="Cinq fils tissés ensemble. Un seul est plus marqué : l’argent." />
      </a>
      <div class="row-demo">
        {([0, 1, 2, 3, 4] as const).map((i) => <FiveStrands variant="stub" strand={i} />)}
      </div>
    </section>

    <section class="demo">
      <p class="demo-id">wmmw/ghosts-lens</p>
      <div class="lens-demo"><GhostsLens locale={locale} /></div>
    </section>

    <section class="demo">
      <p class="demo-id">wmmw/intake-inbox · GhostsNotify</p>
      <GhostsNotify locale={locale} page="/lego" />
    </section>

    <section class="demo">
      <p class="demo-id">wmmw/moire-field</p>
      <p class="doc">Le champ W1 vit sur l’accueil seulement (un seul contexte WebGL par page)&#8239;: <a href="/">voir l’accueil</a>.</p>
    </section>

    <section class="demo">
      <p class="demo-id">wmmw/timeline</p>
      <div class="prose crqpt-compat">
        <Timeline
          items={[
            { n: 1, when: "octobre 2026", title: "La direction est choisie", desc: "Lycurgus, Basteleur, deux moirés." },
            { n: 2, when: "octobre 2026", title: "Le site se construit", desc: "Pages, intake, labo." },
          ]}
        />
      </div>
    </section>

    <section class="demo">
      <p class="demo-id">wmmw/poll</p>
      <div class="prose crqpt-compat">
        <Poll id="lego-demo" question="Cette galerie te sert ?" options={["Oui, je valide dessus", "Bof", "À revoir"]} lang={locale} />
      </div>
    </section>

    <section class="demo">
      <p class="demo-id">wmmw/math</p>
      <div class="prose crqpt-compat"><Math formula="S = k_B \ln \Omega" /></div>
    </section>

    <section class="demo">
      <p class="demo-id">wmmw/zen-countdown</p>
      <div class="prose crqpt-compat"><ZenCountdown lang={locale} /></div>
    </section>

    <section class="demo">
      <p class="demo-id">wmmw/periodic-column</p>
      <div class="prose crqpt-compat"><PeriodicColumn lang={locale} /></div>
    </section>

    <section class="demo">
      <p class="demo-id">wmmw/terminal-panel · héritage</p>
      <TerminalPanel path="~/demo">
        <TermCmd command="echo un panneau terminal, quand un article en a besoin" />
        <p class="out" data-step="fade">un panneau terminal, quand un article en a besoin</p>
      </TerminalPanel>
    </section>

    <section class="demo">
      <p class="demo-id">wmmw/annotation-overlay · wmmw/reports-api</p>
      <p class="doc">
        L’overlay d’annotation s’ouvre avec Alt+Y quand ANNOTATION_SYSTEM=true. Les rapports d’agents se publient en
        POST sur <code>/api/reports</code> (Bearer) et se lisent sur <code>/r/&lt;id&gt;</code>, non listés.
      </p>
    </section>
  </div>
</BaseLayout>

<script>
  import { initTermTyping } from "@lib/term-type";
  document.addEventListener("astro:page-load", initTermTyping);
</script>

<style>
  .demo {
    padding-block: 2.5rem;
    border-top: 1px solid var(--line);
  }
  .demo:first-of-type {
    margin-top: var(--block-gap);
  }
  .demo-id {
    margin: 0 0 1.25rem;
    font-family: var(--mono);
    font-size: var(--fs-meta);
    letter-spacing: var(--ls-mono);
    color: var(--ink-3);
  }
  .row-demo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-bottom: 1.25rem;
  }
  .islands {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 900px) {
    .islands {
      grid-template-columns: 1fr 1fr;
    }
  }
  .island {
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--r-3);
    background: var(--bg);
    color: var(--ink);
  }
  .swatches {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .swatches li {
    display: grid;
    gap: 0.3rem;
    justify-items: start;
  }
  .chip {
    width: 3.5rem;
    height: 2.25rem;
    border: 1px solid var(--line);
    border-radius: var(--r-1);
  }
  .swatches code {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-2);
  }
  .spec-disp {
    margin: 0;
    font-family: var(--disp);
    font-feature-settings: "ss01";
    font-size: var(--fs-h3);
  }
  .spec-body {
    margin: 0.5rem 0 0;
    color: var(--ink-2);
  }
  .spec-mono {
    margin: 0.5rem 0 0;
    font-family: var(--mono);
    font-size: var(--fs-mono);
    color: var(--ink-3);
  }
  .spaced {
    margin-top: 1.5rem;
    max-width: 30rem;
  }
  .strands-demo {
    display: inline-block;
    padding: 0.75rem;
    margin-bottom: 1rem;
  }
  .lens-demo {
    max-width: 400px;
  }
  .doc {
    max-width: 62ch;
    color: var(--ink-2);
  }
</style>
