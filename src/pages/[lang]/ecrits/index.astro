---
import EcritsIndexPage from "@components/pages/EcritsIndexPage.astro";
import type { Locale } from "@i18n/index";

export function getStaticPaths() {
  return ["en", "es"].map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
---

<EcritsIndexPage locale={locale} />
